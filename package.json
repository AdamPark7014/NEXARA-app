{
  "name": "nexara-monorepo",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.0.0",
    "turbo": "^1.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=api --filter=web --filter=mobile-web",
    "dev:all": "turbo run dev --parallel --filter=api --filter=web --filter=mobile-web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "clean:cache": "node scripts/clear-build-cache.js root",
    "prebuild": "npm run clean:cache",
    "build": "turbo run build --concurrency=1 --filter=api --filter=web --filter=mobile-web",
    "build:parallel": "turbo run build --filter=api --filter=web --filter=mobile-web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "build:web:lowmem": "npm run build:lowmem --workspace=apps/web",
    "mobile:cap:sync": "npm run -w apps/mobile cap:build:shell",
    "mobile:cap:sync:prod": "npm run -w apps/mobile cap:build:prod",
    "mobile:cap:android": "npm run -w apps/mobile cap:android:prod",
    "mobile:cap:ios": "npm run -w apps/mobile cap:ios:prod",
    "build:server": "npm run clean:cache && npm run build:api && npm run build:web && npm run build:mobile",
    "build:server:lowmem": "npm run clean:cache && npm run build:api && npm run build:web:lowmem && npm run build:mobile",
    "start": "turbo run start",
    "local:setup": "npm run prisma:generate --workspace=apps/api && npm run prisma:deploy --workspace=apps/api && npm run prisma:seed --workspace=apps/api",
    "local:status": "npm run prisma:status --workspace=apps/api",
    "local:dev": "turbo run dev --parallel"
  },
  "dependencies": {
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/websockets": "^10.0.0",
    "axios": "^1.13.2",
    "basic-ftp": "^5.1.0",
    "class-validator": "^0.14.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  }
}