{
  "name": "nexara-monorepo",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.0.0",
    "turbo": "^1.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=api --filter=web",
    "dev:all": "turbo run dev --parallel --filter=api --filter=web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "clean:cache": "node scripts/clear-build-cache.js root",
    "prebuild": "npm run clean:cache",
    "build": "turbo run build --concurrency=1 --filter=api --filter=web",
    "build:parallel": "turbo run build --filter=api --filter=web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:web:lowmem": "npm run build:lowmem --workspace=apps/web",
    "build:server": "npm run clean:cache && npm run build:api && npm run build:web",
    "build:server:lowmem": "npm run clean:cache && npm run build:api && npm run build:web:lowmem",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm test --workspace=apps/api",
    "test:web": "npm test --workspace=apps/web",
    "start": "turbo run start",
    "local:setup": "npm run prisma:generate --workspace=apps/api && npm run prisma:deploy --workspace=apps/api && npm run prisma:seed --workspace=apps/api",
    "local:status": "npm run prisma:status --workspace=apps/api",
    "local:dev": "turbo run dev --parallel",
    "deploy:up": "bash deploy/nexara.sh up",
    "deploy:up:fast": "bash deploy/nexara.sh up:fast",
    "deploy:rebuild": "bash deploy/nexara.sh rebuild",
    "deploy:ps": "bash deploy/nexara.sh ps",
    "deploy:logs": "bash deploy/nexara.sh logs",
    "deploy:restart": "bash deploy/nexara.sh restart",
    "deploy:down": "bash deploy/nexara.sh down",
    "deploy:migrate": "bash deploy/nexara.sh migrate",
    "deploy:validate": "bash deploy/nexara.sh validate",
    "apk:install": "pwsh -ExecutionPolicy Bypass -File scripts/install-apk-windows.ps1",
    "apk:build-install": "pwsh -ExecutionPolicy Bypass -File scripts/install-apk-windows.ps1 -Build",
    "mobile:android:preview": "pwsh -ExecutionPolicy Bypass -File scripts/preview-android-emulator.ps1",
    "mobile:android:screenshots": "pwsh -ExecutionPolicy Bypass -File scripts/capture-play-screenshots.ps1",
    "mobile:android:icons": "python scripts/gen-native-app-icons.py",
    "mobile:parity": "python scripts/check-app-web-parity.py",
    "mobile:android:play-aab": "pwsh -ExecutionPolicy Bypass -File scripts/build-play-aab.ps1",
    "mobile:smoke": "pwsh -ExecutionPolicy Bypass -File scripts/mobile-smoke-checklist.ps1",
    "seed:play-reviewer": "npm run seed:play-reviewer --workspace=apps/api",
    "integra:isapi:scan": "npm run integra:isapi:scan --workspace=apps/api --",
    "integra:isapi:seed": "npm run integra:isapi:seed --workspace=apps/api --"
  },
  "prisma": {
    "seed": "node apps/api/prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/websockets": "^10.0.0",
    "axios": "^1.13.2",
    "basic-ftp": "^5.1.0",
    "class-validator": "^0.14.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  }
}
