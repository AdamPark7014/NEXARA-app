<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep dark background: radial gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="64">
                <item android:offset="0.0" android:color="#FF1c2f40" />
                <item android:offset="0.50" android:color="#FF0e1c2a" />
                <item android:offset="1.0"  android:color="#FF060d14" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Teal ambient inner glow -->
    <path android:pathData="M54,54m-38,0a38,38,0,1,1,76,0a38,38,0,1,1,-76,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42">
                <item android:offset="0.0" android:color="#2E15a99d" />
                <item android:offset="0.72" android:color="#0E15a99d" />
                <item android:offset="1.0"  android:color="#0015a99d" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- N drop shadow -->
    <path
        android:fillType="nonZero"
        android:pathData="M24.5,25.5 L40.5,25.5 L88.5,89.5 L72.5,89.5 Z M24.5,25.5 L40.5,25.5 L40.5,89.5 L24.5,89.5 Z M72.5,25.5 L88.5,25.5 L88.5,89.5 L72.5,89.5 Z"
        android:fillColor="#55000000" />

    <!-- N main body: teal gradient top-left to bottom-right -->
    <path
        android:fillType="nonZero"
        android:pathData="M22,22 L38,22 L86,86 L70,86 Z M22,22 L38,22 L38,86 L22,86 Z M70,22 L86,22 L86,86 L70,86 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="22"
                android:endX="86"
                android:endY="86">
                <item android:offset="0.00" android:color="#FFd8f9f4" />
                <item android:offset="0.14" android:color="#FF79e6dd" />
                <item android:offset="0.36" android:color="#FF36bcae" />
                <item android:offset="0.60" android:color="#FF15a99d" />
                <item android:offset="0.84" android:color="#FF0b8078" />
                <item android:offset="1.00" android:color="#FF065e58" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bevel: bright top-edge on both stems -->
    <path
        android:fillType="nonZero"
        android:pathData="M22,22 L38,22 L38,26 L22,26 Z M70,22 L86,22 L86,26 L70,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="0"
                android:endX="86"
                android:endY="0">
                <item android:offset="0.0"  android:color="#EEFFFFFF" />
                <item android:offset="0.45" android:color="#AAFFFFFF" />
                <item android:offset="1.0"  android:color="#66FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bevel: bright left-edge on left stem -->
    <path android:pathData="M22,22 L26,22 L26,86 L22,86 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="22"
                android:endX="0"
                android:endY="86">
                <item android:offset="0.0"  android:color="#CCFFFFFF" />
                <item android:offset="0.38" android:color="#66FFFFFF" />
                <item android:offset="1.0"  android:color="#22FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular corner at top-left -->
    <path
        android:fillType="nonZero"
        android:pathData="M22,22 L34,22 L34,28 L22,28 Z M22,22 L28,22 L28,34 L22,34 Z"
        android:fillColor="#AAFFFFFF" />

    <!-- Shadow: dark right-edge on right stem -->
    <path android:pathData="M82,22 L86,22 L86,86 L82,86 Z" android:fillColor="#2E000000" />

    <!-- Shadow: dark bottom-edge on both stems -->
    <path
        android:fillType="nonZero"
        android:pathData="M22,83 L22,86 L38,86 L38,83 Z M70,83 L70,86 L86,86 L86,83 Z"
        android:fillColor="#33000000" />

    <!-- Diagonal sheen triangle -->
    <path android:pathData="M36,22 L40,22 L40,26 Z" android:fillColor="#66FFFFFF" />

</vector>
