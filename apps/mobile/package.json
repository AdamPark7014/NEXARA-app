{
  "name": "mobile-web",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -p 3002",
    "prebuild": "node ../../scripts/clear-build-cache.js mobile",
    "build": "node --max-old-space-size=2048 ../../node_modules/next/dist/bin/next build",
    "start": "next start -p 3002",
    "cap:sync:shell": "npx cap sync",
    "cap:android:init": "npx cap add android",
    "cap:android:open": "npx cap open android",
    "cap:ios:open": "npx cap open ios",
    "cap:build:shell": "npm run cap:sync:shell",
    "cap:build:prod": "cross-env CAPACITOR_APP_URL=https://mobile.nexara.com.mx npm run cap:build:shell",
    "cap:android:prod": "cross-env CAPACITOR_APP_URL=https://mobile.nexara.com.mx npm run cap:build:shell && npm run cap:android:open",
    "cap:ios:prod": "cross-env CAPACITOR_APP_URL=https://mobile.nexara.com.mx npm run cap:build:shell && npm run cap:ios:open",
    "build:capacitor": "cross-env CAPACITOR=1 node --max-old-space-size=2048 ../../node_modules/next/dist/bin/next build",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:build": "npm run build:capacitor && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/styled-engine": "^7.3.7",
    "@mui/system": "^7.3.7",
    "@react-pdf-viewer/core": "^3.12.0",
    "axios": "^1.13.2",
    "next": "^14.2.35",
    "pdfjs-dist": "^3.11.174",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-easy-crop": "^5.5.6",
    "recharts": "^3.6.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.17",
    "cross-env": "^7.0.3",
    "sass": "^1.83.4",
    "typescript": "^5.0.0"
  }
}
