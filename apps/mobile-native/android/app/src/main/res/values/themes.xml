<resources>
    <!-- Tema base de la aplicación. La UI real se renderiza con Jetpack Compose + MaterialTheme. -->
    <style name="Theme.Nexara" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <style name="Theme.Nexara.Splash" parent="Theme.Nexara">
        <item name="android:windowBackground">@color/nexara_primary</item>
    </style>
</resources>
