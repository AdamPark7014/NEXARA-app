{
  "name": "api",
  "version": "1.0.0",
  "description": "NestJS API for Nexara-app",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node -r ts-node/register/transpile-only ./src/worker.ts",
    "dev": "nest start --watch",
    "dev:worker": "node -r ts-node/register/transpile-only ./src/worker.ts",
    "prebuild": "node ../../scripts/clear-build-cache.js api",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=3072 nest build",
    "test": "jest --config jest.config.js --runInBand",
    "test:cov": "jest --config jest.config.js --coverage --runInBand",
    "eval:ia": "cross-env TS_NODE_PROJECT=src/ai/eval/tsconfig.json node -r ts-node/register src/ai/eval/correr.ts",
    "eval:asistente-chat": "cross-env TS_NODE_PROJECT=src/ai/eval/tsconfig.json node -r ts-node/register src/ai/eval/correr-asistente-chat.ts",
    "eval:duplicados": "cross-env TS_NODE_PROJECT=src/ai/eval/tsconfig.json node -r ts-node/register src/ai/eval/correr-duplicados.ts",
    "eval:cotizar": "cross-env TS_NODE_PROJECT=src/ai/eval/tsconfig.json node -r ts-node/register src/ai/eval/correr-cotizar.ts",
    "eval:redactar": "cross-env TS_NODE_PROJECT=src/ai/eval/tsconfig.json node -r ts-node/register src/ai/eval/correr-redactar.ts",
    "eval:ficha": "cross-env TS_NODE_PROJECT=src/ai/eval/tsconfig.json node -r ts-node/register src/ai/eval/correr-ficha.ts",
    "eval:sitio": "cross-env TS_NODE_PROJECT=src/ai/eval/tsconfig.json node -r ts-node/register src/ai/eval/correr-sitio.ts",
    "user:reset-password": "ts-node ./src/users/reset-user-password.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "seed:play-reviewer": "ts-node -P ./prisma/tsconfig.seed.json ./prisma/seed-play-reviewer.ts",
    "seed:play-demo": "ts-node -P ./prisma/tsconfig.seed.json ./prisma/seed-play-demo-data.ts",
    "seed:plantillas": "ts-node --transpile-only -P ./prisma/tsconfig.seed.json ./prisma/seed-nexara-plantillas.ts",
    "audit:org-users": "node ./scripts/audit-org-users.mjs",
    "generate:vapid": "web-push generate-vapid-keys",
    "integra:isapi:scan": "node --env-file-if-exists=.env -r ./scripts/ts-node-js-ext.js -r ts-node/register/transpile-only ./src/hikvision-isapi/isapi-scan.ts",
    "integra:isapi:seed": "node --env-file-if-exists=.env -r ./scripts/ts-node-js-ext.js -r ts-node/register/transpile-only ./src/hikvision-isapi/isapi-seed.ts",
    "integra:isapi:sync": "node --env-file-if-exists=.env -r ./scripts/ts-node-js-ext.js -r ts-node/register/transpile-only ./src/hikvision-isapi/isapi-sync.ts",
    "integra:isapi:publish": "node --env-file-if-exists=.env -r ./scripts/ts-node-js-ext.js -r ts-node/register/transpile-only ./src/hikvision-isapi/isapi-publish.ts",
    "pac:preflight": "node --env-file-if-exists=.env -r ./scripts/ts-node-js-ext.js -r ts-node/register/transpile-only ./src/pac/pac-preflight.cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "axios": "^1.21.1",
    "basic-ftp": "^5.3.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cross-env": "^7.0.3",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.5.0",
    "openai": "^6.49.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.2",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "sharp": "^0.33.5",
    "stripe": "^18.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "yn": "^3.1.1"
  },
  "prisma": {
    "seed": "ts-node ./prisma/seed-core-roster.ts"
  }
}
