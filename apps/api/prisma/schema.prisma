  @@unique([companyId, section])
  @@index([companyId])
  @@map("page_content")
}

/// Snapshot de PageContent tomado justo antes de cada publish — permite
/// ver el historial de versiones publicadas y revertir a una anterior.
model PageContentRevision {
  id          Int            @id @default(autoincrement())
  section     String         @db.VarChar(80)
  version     Int
  content     Json
  publishedBy String?        @db.VarChar(255)
