  /// métricas a las 17:00 y no había dónde registrarlas.
  impresiones   Int?
  alcance       Int?
  interacciones Int?
  clics         Int?
  metricasAt    DateTime?
  autor         User           @relation("SocialPostAuthor", fields: [autorId], references: [id])
  company       CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([estado, cuando])
  @@index([companyId])
}

// ============================================================================
// COMUNICADOS INTERNOS (erp/news — mensajes al equipo)
// ============================================================================
model InternalComunicado {
  id                 Int            @id @default(autoincrement())
  titulo             String         @db.VarChar(300)
  cuerpo             String         @db.Text
  audiencia          String         @db.VarChar(200)
  prioridad          String         @default("Normal") @db.VarChar(20)
  estado             String         @default("Borrador") @db.VarChar(20)
  scheduledAt        DateTime?
  sentAt             DateTime?
  lecturas           Int            @default(0)
  totalDestinatarios Int            @default(0)
  autorId            Int
  companyId          Int
  autor              User           @relation("ComunicadoAuthor", fields: [autorId], references: [id])
  company            CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([estado, createdAt])
  @@index([companyId])
}

// ============================================================================
// WORKSPACE CHAT (Slack-like — channels, DMs, threads, document rooms)
// ============================================================================

enum ChatChannelKind {
  PUBLIC
  PRIVATE
  DIRECT
  DOCUMENT
}

enum ChatMessageKind {
  TEXT
  SYSTEM
  FILE
}

model ChatChannel {
  id                 Int                 @id @default(autoincrement())
  kind               ChatChannelKind     @default(PUBLIC)
  slug               String?             @db.VarChar(80)
  name               String              @db.VarChar(120)
  topic              String?             @db.VarChar(500)
  description        String?             @db.VarChar(1000)
  isArchived         Boolean             @default(false)
  documentId         Int?                @unique
  dmKey              String?             @db.VarChar(64)
  companyId          Int
  createdById        Int?
  lastMessageAt      DateTime?
  lastMessagePreview String?             @db.VarChar(280)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  document           ManagedDocument?    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  company            CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("ChatChannelCreator", fields: [createdById], references: [id])
  members            ChatChannelMember[]
  messages           ChatMessage[]

  @@unique([companyId, slug])
  @@unique([companyId, dmKey])
  @@index([kind, lastMessageAt])
  @@index([companyId])
  @@map("chat_channels")
}

model ChatChannelMember {
  id         Int         @id @default(autoincrement())
  channelId  Int
  userId     Int
  role       String      @default("member") @db.VarChar(20)
  lastReadAt DateTime?
  mutedUntil DateTime?
  joinedAt   DateTime    @default(now())
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User        @relation("ChatChannelMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId, lastReadAt])
  @@map("chat_channel_members")
}

model ChatMessage {
  id             Int                   @id @default(autoincrement())
  channelId      Int
  authorId       Int
  parentId       Int?
  kind           ChatMessageKind       @default(TEXT)
  body           String                @db.Text
  attachmentUrl  String?               @db.VarChar(500)
  attachmentName String?               @db.VarChar(255)
  pinnedAt       DateTime?
  pinnedById     Int?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  channel        ChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author         User                  @relation("ChatMessageAuthor", fields: [authorId], references: [id])
  pinnedBy       User?                 @relation("ChatMessagePinner", fields: [pinnedById], references: [id], onDelete: SetNull)
  parent         ChatMessage?          @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ChatMessage[]         @relation("ChatThread")
  reactions      ChatMessageReaction[]
  companyId      Int
  company        CompanyProfile        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@index([channelId, pinnedAt])
  @@index([companyId])
  @@map("chat_messages")
}

model ChatMessageReaction {
  id        Int         @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String      @db.VarChar(32)
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation("ChatReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("chat_message_reactions")
}

/// Webhooks outbound — integración enterprise (Stripe/Atlassian-style)
model OutboundWebhook {
  id             Int               @id @default(autoincrement())
  name           String            @db.VarChar(120)
  url            String            @db.VarChar(500)
  secret         String?           @db.VarChar(120)
  events         String[]          @default([])
  isActive       Boolean           @default(true)
  failureCount   Int               @default(0)
  lastDeliveryAt DateTime?
  lastStatusCode Int?
  companyId      Int
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    Int?
  company        CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries     WebhookDelivery[]

  @@index([isActive])
  @@index([companyId, isActive])
  @@map("outbound_webhooks")
}

model WebhookDelivery {
  id           Int             @id @default(autoincrement())
  webhookId    Int
  event        String          @db.VarChar(80)
  payload      Json
  status       String          @default("pending") @db.VarChar(20)
  responseCode Int?
  responseBody String?         @db.VarChar(1000)
  attempts     Int             @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime        @default(now())
  deliveredAt  DateTime?
  webhook      OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

/// Rol de una persona dentro de una actividad.
enum ActivityAssigneeRole {
  LEAD
  TECNICO
  APOYO
}

/// Equipo asignado a una actividad.
///
/// `Activity.responsableId` admite una sola persona, así que una instalación
/// con tres técnicos registraba a uno y los otros dos no figuraban en ninguna
/// parte: ni sus horas, ni su presencia en la evidencia. El responsable se
/// conserva como líder para no romper las consultas existentes.
///
/// Los viáticos siguen siendo individuales (`Viatico.usuarioId` +
/// `actividadId`): cada asignado solicita los suyos, no se prorratean.
model ActivityAssignee {
  id          Int                  @id @default(autoincrement())
  activityId  Int
  userId      Int
  rol         ActivityAssigneeRole @default(TECNICO)
  /// Horas previstas para esta persona en esta actividad.
  horasPlan   Decimal?             @db.Decimal(6, 2)
  /// Horas realmente dedicadas, para el costo real del servicio.
  horasReales Decimal?             @db.Decimal(6, 2)
  asignadoAt  DateTime             @default(now())
  /// Fecha de salida del equipo; null mientras sigue asignado.
  retiradoAt  DateTime?
  companyId   Int

  activity Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User           @relation("ActivityAssignedUser", fields: [userId], references: [id])
  company  CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([activityId, userId])
  @@index([userId, retiradoAt])
  @@index([companyId])
  @@map("activity_assignees")
}

/// Reasignación de una actividad inconclusa.
///
/// Antes cambiar `responsableId` pisaba el valor anterior: se perdía quién la
/// tenía, quién la movió y por qué. Al reasignar, el nuevo responsable solicita
/// sus propios viáticos; los del anterior quedan a su nombre.
model ActivityReassignment {
  id          Int      @id @default(autoincrement())
  activityId  Int
  deUsuarioId Int?
  aUsuarioId  Int
  movidaPorId Int
  motivo      String?  @db.VarChar(400)
  createdAt   DateTime @default(now())
  companyId   Int

  activity  Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  deUsuario User?          @relation("ActivityReassignFrom", fields: [deUsuarioId], references: [id])
  aUsuario  User           @relation("ActivityReassignTo", fields: [aUsuarioId], references: [id])
  movidaPor User           @relation("ActivityReassignBy", fields: [movidaPorId], references: [id])
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([activityId, createdAt])
  @@index([companyId])
  @@map("activity_reassignments")
}

/// Escalón de precio por volumen pactado con un mayorista.
///
/// Comprar 5 piezas y comprar 500 costaba lo mismo en el sistema: sólo existía
/// `SupplierProduct.price`, un precio único. El escalón vigente se elige por la
/// cantidad de la línea, de mayor a menor `cantidadMinima`.
model SupplierPriceBreak {
  id             Int       @id @default(autoincrement())
  supplierId     Int
  productId      Int
  /// Cantidad a partir de la cual aplica este precio.
  cantidadMinima Decimal   @db.Decimal(14, 4)
  unitPrice      Decimal   @db.Decimal(14, 4)
  currency       String    @default("MXN") @db.VarChar(10)
  /// Vigencia. Fuera de ella el escalón no se considera.
  vigenteDesde   DateTime? @db.Date
  vigenteHasta   DateTime? @db.Date
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  companyId      Int

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  company  CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([supplierId, productId, cantidadMinima])
  @@index([productId, cantidadMinima])
  @@index([companyId])
  @@map("supplier_price_breaks")
}

/// Naturaleza de una incidencia de campo.
enum ActivityIncidentType {
  ACCESO_DENEGADO
  FALTA_MATERIAL
  FALLA_EQUIPO
  CONDICION_INSEGURA
  CLIMA
  ALCANCE_ADICIONAL
  RETRASO_CLIENTE
  DANO_INSTALACION
  OTRO
}

/// Gravedad de una incidencia de campo. Distinta de `IncidentSeverity`, que
/// clasifica accidentes laborales (NEAR_MISS…FATALITY) y no aplica aquí.
enum ActivityIncidentSeverity {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

/// Incidencia ocurrida durante un servicio.
///
/// Antes esto vivía en `ServiceSheet.observations`, texto libre: no se podía
/// contar cuántas veces se fue por falta de material ni qué cliente niega el
/// acceso con frecuencia. Tipificarlo convierte el relato en una cifra.
model ActivityIncident {
  id             Int                      @id @default(autoincrement())
  activityId     Int
  tipo           ActivityIncidentType
  severidad      ActivityIncidentSeverity @default(MEDIA)
  descripcion    String                   @db.Text
  /// Qué se hizo en el momento.
  accionTomada   String?                  @db.Text
  /// Horas perdidas por la incidencia, para costo real del servicio.
  horasPerdidas  Decimal?                 @db.Decimal(6, 2)
  reportadoPorId Int?
  resueltoPorId  Int?
  resueltoAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  companyId      Int

  activity     Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  reportadoPor User?          @relation("IncidentReporter", fields: [reportadoPorId], references: [id])
  resueltoPor  User?          @relation("IncidentResolver", fields: [resueltoPorId], references: [id])
  company      CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([companyId, tipo])
  @@index([companyId, severidad, resueltoAt])
  @@map("activity_incidents")
}

enum RecommendationType {
  CORRECTIVO
  PREVENTIVO
  MEJORA
  ACTUALIZACION
  CAPACITACION
  AMPLIACION
}

enum RecommendationPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum RecommendationStatus {
  ABIERTA
  COTIZADA
  ACEPTADA
  RECHAZADA
  DESCARTADA
}

/// Recomendación técnica derivada de un servicio.
///
/// El técnico ve en sitio lo que hay que cambiar, pero eso moría en la hoja de
/// servicio. Con `cotizacionId` la observación de Ingeniería llega a Ventas y
/// se puede medir cuánta facturación nace del trabajo de campo.
model ActivityRecommendation {
  id            Int                    @id @default(autoincrement())
  activityId    Int
  tipo          RecommendationType
  prioridad     RecommendationPriority @default(MEDIA)
  estado        RecommendationStatus   @default(ABIERTA)
  descripcion   String                 @db.Text
  /// Estimación del técnico, antes de que Ventas cotice formalmente.
  costoEstimado Decimal?               @db.Decimal(14, 2)
  /// Cotización que nació de esta recomendación.
  cotizacionId  Int?
  creadoPorId   Int?
  cerradoAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  companyId     Int

  activity   Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  cotizacion Cotizacion?    @relation(fields: [cotizacionId], references: [id], onDelete: SetNull)
  creadoPor  User?          @relation("RecommendationAuthor", fields: [creadoPorId], references: [id])
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([companyId, estado])
  @@index([cotizacionId])
  @@map("activity_recommendations")
}

/// Los cuatro ritmos que describe el organigrama.
enum MeetingType {
  DIARIA
  PLANEACION_SEMANAL
  REVISION_AVANCES
  CIERRE_SEMANAL
  EXTRAORDINARIA
}

enum MeetingStatus {
  PROGRAMADA
  REALIZADA
  CANCELADA
}

/// Reunión operativa: la diaria de las 10:00, la planeación del lunes, la
/// revisión del miércoles y la junta de cierre del viernes.
///
/// El pulso de la empresa vivía fuera del ERP, así que los acuerdos no quedaban
/// ligados a las actividades de las que se hablaba.
model OperationalMeeting {
  id            Int           @id @default(autoincrement())
  tipo          MeetingType
  titulo        String        @db.VarChar(200)
  fecha         DateTime      @db.Date
  horaInicio    String?       @db.VarChar(5)
  estado        MeetingStatus @default(PROGRAMADA)
  agenda        String?       @db.Text
  notas         String?       @db.Text
  facilitadorId Int?
  realizadaAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  companyId     Int

  facilitador User?              @relation("MeetingFacilitator", fields: [facilitadorId], references: [id])
  company     CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  asistentes  MeetingAttendee[]
  acuerdos    MeetingAgreement[]

  @@index([companyId, fecha])
  @@index([companyId, tipo, fecha])
  @@map("operational_meetings")
}

/// Convocado a una reunión y si asistió.
model MeetingAttendee {
  id        Int      @id @default(autoincrement())
  meetingId Int
  userId    Int
  asistio   Boolean  @default(false)
  createdAt DateTime @default(now())

  meeting OperationalMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_attendees")
}

/// Un acuerdo tiene responsable y fecha; una lección y un riesgo, no.
enum AgreementKind {
  ACUERDO
  LECCION
  RIESGO
}

enum AgreementStatus {
  PENDIENTE
  EN_PROCESO
  CUMPLIDO
  CANCELADO
}

/// Lo que sale de una reunión: acuerdos con responsable, lecciones aprendidas y
/// riesgos detectados. `activityId` liga el acuerdo al servicio del que se habló.
model MeetingAgreement {
  id              Int             @id @default(autoincrement())
  meetingId       Int
  tipo            AgreementKind   @default(ACUERDO)
  descripcion     String          @db.Text
  responsableId   Int?
  fechaCompromiso DateTime?       @db.Date
  estado          AgreementStatus @default(PENDIENTE)
  cumplidoAt      DateTime?
  activityId      Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  companyId       Int

  meeting     OperationalMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  responsable User?              @relation("AgreementOwner", fields: [responsableId], references: [id])
  activity    Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  company     CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([meetingId])
  @@index([companyId, estado, fechaCompromiso])
  @@index([responsableId, estado])
  @@map("meeting_agreements")
}

/// Contador de folios por empresa y serie.
///
/// Antes cada folio salía de `count() + 1` sobre la tabla destino. Eso rompía
/// de dos maneras:
///
///   1. Dos altas simultáneas leían el mismo `count` y generaban el mismo
///      folio; la segunda moría contra el índice único.
///   2. Peor en las tablas con borrado suave (`Invoice`, `PurchaseOrder`): el
///      middleware excluye lo borrado de las lecturas, así que al borrar un
///      registro el contador **retrocedía** y el siguiente folio chocaba con
///      uno que ya existía. No se recuperaba solo: toda alta posterior fallaba.
///
/// El contador vive aquí y se incrementa de forma atómica, así que ni la
/// concurrencia ni los borrados lo mueven hacia atrás.
model FolioCounter {
  id        Int      @id @default(autoincrement())
  /// Prefijo resuelto de la serie: "PO-", "INV-", "LIC-2026-"…
  serie     String   @db.VarChar(20)
  valor     Int      @default(0)
  companyId Int
  updatedAt DateTime @updatedAt

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, serie])
  @@map("folio_counters")
}

// ─── NEXARA Integra (HikCentral Artemis mirror + multi-sitio) ─────────────

enum IntegraDeviceKind {
  ACS
  ENCODE
}

enum IntegraSyncStatus {
  RUNNING
  OK
  ERROR
}

/// Credenciales Artemis/HCT por empresa (cifradas). Fallback: env INTEGRA_HIK_*.
model IntegraSite {
  id              Int       @id @default(autoincrement())
  companyId       Int
  name            String    @db.VarChar(160)
  host            String    @db.VarChar(500)
  /// AES-GCM payload (base64)
  appKeyEnc       String    @db.Text
  appSecretEnc    String    @db.Text
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false)
  lastSyncAt      DateTime?
  lastHealthOkAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cameras  IntegraCamera[]
  doors    IntegraDoor[]
  people   IntegraPerson[]
  devices  IntegraDevice[]
  vehicles IntegraVehicle[]
  regions    IntegraRegion[]
  syncRuns   IntegraSyncRun[]
  alarmAcks  IntegraAlarmAck[]
  floorplans IntegraFloorplan[]
  edgeAgent  IntegraEdgeAgent?
  pushEvents IntegraPushEvent[]
  /// sha256 del token que los equipos llevan en la URL de notificacion.
  /// Solo el hash: el token en claro se ensena una vez al configurarlos.
  pushTokenHash String?  @db.VarChar(64)
  pushTokenAt   DateTime?
  /// Cliente operativo ERP (opcional) — no confundir con CompanyProfile
  serviceClientId Int?
  /// Override de módulos visibles: { "video": true, "anpr": false, ... }
  modulesOverride Json?
  label           String?  @db.VarChar(120)
  notes           String?  @db.Text
  /// ARTEMIS (HikCentral on-prem) | HCT (Hik-Connect for Teams cloud) — ADR-0019
  provider        String   @default("ARTEMIS") @db.VarChar(16)

  @@index([companyId, isActive])
  @@unique([companyId, name])
  @@map("integra_sites")
}

/// Caja on-site que cierra el tunel de un sitio ISAPI y corre go2rtc + sync.
/// El servidor nunca entra a la LAN del cliente: habla solo con esta caja
/// por su `tunnelIp`, que es unica por sitio. Ver ADR-0021.
model IntegraEdgeAgent {
  id        Int @id @default(autoincrement())
  companyId Int
  /// Un sitio tiene como mucho una caja.
  siteId    Int @unique

  /// sha256 del token de alta, de un solo uso. El token en claro se muestra
  /// una vez al generarlo y no se vuelve a poder leer.
  enrollTokenHash      String?   @db.VarChar(64)
  enrollTokenExpiresAt DateTime?
  /// sha256 del token permanente que la caja usa despues de enrolarse.
  agentTokenHash       String?   @db.VarChar(64)

  /// Clave publica WireGuard de la caja (base64, 44 chars).
  publicKey String? @db.VarChar(64)
  /// IP dentro del tunel (10.77.0.x). Unica en toda la instalacion.
  tunnelIp  String? @unique @db.VarChar(45)

  hostname     String? @db.VarChar(120)
  agentVersion String? @db.VarChar(40)

  /// PENDING (token emitido) | ENROLLED (caja activa) | REVOKED
  status     String    @default("PENDING") @db.VarChar(16)
  enrolledAt DateTime?
  lastSeenAt DateTime?
  lastSyncAt DateTime?
  lastError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("integra_edge_agents")
}

model IntegraRegion {
  id              Int      @id @default(autoincrement())
  companyId       Int
  siteId          Int
  indexCode       String   @db.VarChar(120)
  name            String   @db.VarChar(220)
  parentIndexCode String?  @db.VarChar(120)
  raw             Json?
  syncedAt        DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, indexCode])
  @@index([companyId])
  @@map("integra_regions")
}

model IntegraCamera {
  id               Int      @id @default(autoincrement())
  companyId        Int
  siteId           Int
  cameraIndexCode  String   @db.VarChar(120)
  name             String   @db.VarChar(220)
  regionName       String?  @db.VarChar(220)
  regionIndexCode  String?  @db.VarChar(120)
  status           String?  @db.VarChar(40)
  encodeDevIndexCode String? @db.VarChar(120)
  raw              Json?
  syncedAt         DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, cameraIndexCode])
  @@index([companyId])
  @@map("integra_cameras")
}

model IntegraDoor {
  id              Int      @id @default(autoincrement())
  companyId       Int
  siteId          Int
  doorIndexCode   String   @db.VarChar(120)
  name            String   @db.VarChar(220)
  regionName      String?  @db.VarChar(220)
  regionIndexCode String?  @db.VarChar(120)
  online          Boolean  @default(true)
  doorState       String?  @db.VarChar(40)
  raw             Json?
  syncedAt        DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, doorIndexCode])
  @@index([companyId])
  @@map("integra_doors")
}

/// Ack/clear operativo NEXARA sobre alarmas Artemis (fuente de verdad SOC local).
model IntegraAlarmAck {
  id               Int       @id @default(autoincrement())
  companyId        Int
  siteId           Int
  externalAlarmId  String    @db.VarChar(220)
  /// ACK | CLEARED (OPEN = sin fila)
  status           String    @default("ACK") @db.VarChar(16)
  note             String?   @db.Text
  userId           Int?
  severity         String?   @db.VarChar(40)
  title            String?   @db.VarChar(280)
  raw              Json?
  ackedAt          DateTime  @default(now())
  clearedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, externalAlarmId])
  @@index([companyId, status])
  @@map("integra_alarm_acks")
}

model IntegraFloorplan {
  id        Int      @id @default(autoincrement())
  companyId Int
  siteId    Int
  name      String   @db.VarChar(160)
  /// data URL o URL pública (MVP)
  imageData String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pins    IntegraMapPin[]

  @@index([siteId])
  @@index([companyId])
  @@map("integra_floorplans")
}

model IntegraMapPin {
  id          Int      @id @default(autoincrement())
  floorplanId Int
  /// CAMERA | DOOR
  entityType  String   @db.VarChar(16)
  entityId    String   @db.VarChar(120)
  label       String?  @db.VarChar(220)
  xPct        Float
  yPct        Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floorplan IntegraFloorplan @relation(fields: [floorplanId], references: [id], onDelete: Cascade)

  @@unique([floorplanId, entityType, entityId])
  @@index([floorplanId])
  @@map("integra_map_pins")
}

model IntegraPerson {
  id            Int      @id @default(autoincrement())
  companyId     Int
  siteId        Int
  personId      String   @db.VarChar(120)
  personName    String   @db.VarChar(220)
  personCode    String?  @db.VarChar(120)
  orgIndexCode  String?  @db.VarChar(120)
  orgName       String?  @db.VarChar(220)
  raw           Json?
  syncedAt      DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, personId])
  @@index([companyId])
  @@map("integra_people")
}

/// Evento que el equipo **empuja** a NEXARA, no que NEXARA le pregunta.
///
/// El sondeo cada 4 s llega tarde y sin imagen. Con el empuje el evento entra
/// en menos de un segundo, que es lo que permite tomarle la foto a quien acaba
/// de pasar por la puerta: el terminal no entrega la suya —medido: 596 eventos
/// del alertStream, cero JPEG— pero como camara responde en ~300 ms.
model IntegraPushEvent {
  id        Int      @id @default(autoincrement())
  companyId Int
  siteId    Int
  /// IP del equipo que lo mando. Es lo unico que el aparato firma de si mismo.
  deviceIp    String  @db.VarChar(64)
  deviceName  String? @db.VarChar(220)
  /// AccessControllerEvent | VMD | fielddetection | linedetection | facedetection…
  eventType   String  @db.VarChar(64)
  major       Int?
  minor       Int?
  /// Etiqueta legible ya resuelta, para no recalcularla en cada consulta.
  label       String? @db.VarChar(160)
  occurredAt  DateTime
  receivedAt  DateTime @default(now())

  personId    String? @db.VarChar(64)
  personName  String? @db.VarChar(220)
  doorNo      Int?
  verifyMode  String? @db.VarChar(64)
  /// Ruta bajo /uploads: la foto que NEXARA tomo del equipo al recibirlo.
  photoPath   String? @db.VarChar(300)
  /// Recuadros de deteccion normalizados 0..1, con su tipo (human/vehicle).
  targets     Json?
  raw         Json?

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, occurredAt])
  @@index([siteId, personId, occurredAt])
  @@index([companyId, occurredAt])
  @@map("integra_push_events")
}

model IntegraDevice {
  id          Int               @id @default(autoincrement())
  companyId   Int
  siteId      Int
  indexCode   String            @db.VarChar(120)
  name        String            @db.VarChar(220)
  kind        IntegraDeviceKind
