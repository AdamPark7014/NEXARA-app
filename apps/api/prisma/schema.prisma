/// Idempotency-Key store (Stripe-style) — evita mutaciones duplicadas.
model IdempotencyKey {
  id           Int             @id @default(autoincrement())
  key          String          @db.VarChar(120)
  companyId    Int?
  userId       Int?
  method       String          @db.VarChar(10)
  path         String          @db.VarChar(300)
  requestHash  String?         @db.VarChar(64)
  statusCode   Int
  responseBody Json?
  createdAt    DateTime        @default(now())
  expiresAt    DateTime
  company      CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, method, path])
  @@index([expiresAt])
  @@index([companyId])
  @@map("idempotency_keys")
}

/// Membresía User ↔ Company (tenant NEXARA). Sin esto el switcher es cosmético.
model UserCompany {
  id             Int            @id @default(autoincrement())
  userId         Int
  companyId      Int
  isDefault      Boolean        @default(false)
  /// Número de empleado local al tenant (permite reutilizar códigos entre empresas).
  employeeNumber String?        @db.VarChar(40)
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@map("user_companies")
}

/// API keys por empresa — auth machine-to-machine scoped al tenant.
model CompanyApiKey {
  id          Int            @id @default(autoincrement())
  companyId   Int
  name        String         @db.VarChar(120)
  keyPrefix   String         @db.VarChar(12)
  keyHash     String         @db.VarChar(64)
  scopes      String[]       @default([])
  isActive    Boolean        @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  createdById Int?
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("CompanyApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([keyHash])
  @@index([companyId, isActive])
  @@index([keyPrefix])
  @@map("company_api_keys")
}

/// Metering de uso por tenant (base billing SaaS).
model CompanyUsageEvent {
  id         Int            @id @default(autoincrement())
  companyId  Int
  metric     String         @db.VarChar(60)
  quantity   Decimal        @default(1) @db.Decimal(16, 4)
  metadata   Json?
  occurredAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, metric, occurredAt])
  @@map("company_usage_events")
}

// ============================================================================
// CASOS DE ÉXITO (studio/cases → sitio público /casos)
