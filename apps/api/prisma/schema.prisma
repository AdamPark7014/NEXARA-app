generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              Int             @id @default(autoincrement())
  sku             String
  name            String
  description     String?
  specifications  Json?
  imageUrl        String?
  category        String?
  subcategory     String?
  price           Float?
  currency        String?
  icecatId        String?
  satProductKey   String?         @db.VarChar(10)
  satUnitKey      String?         @db.VarChar(5)
  unitName        String?         @db.VarChar(50)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  brandId         Int?
  ean             String?
  icecatDatasheet String?
  thumbnailUrl    String?
  upc             String?
  activo          Boolean?        @default(true)
  itemType        CatalogItemType @default(PRODUCT)
  existencia      Json?
  promociones     Json?
  protegido       Boolean?        @default(false)
  sustituto       String?
  tipoCambio      Float?
  companyId       Int
  brand           Brand?          @relation(fields: [brandId], references: [id])
  company         CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sources         ProductSource[]

  // === ERP Industrial Relations ===
  invoiceItems        InvoiceItem[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  lots                Lot[]
  purchaseReqItems    PurchaseRequisitionItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  boms                BillOfMaterials[]         @relation("ProductBOM")
  cotizacionItems     CotizacionItem[]
  salesOrderLines     SalesProjectOrderLine[]
  bomComponents       BOMComponent[]            @relation("BOMComponentProduct")
  productionOrders    ProductionOrder[]
  qualityInspections  QualityInspection[]
  ncrs                NonConformanceReport[]
  maintenanceParts    MaintenanceOrderPart[]
  cycleCountItems     CycleCountItem[]
  stockReservations   StockReservation[]
  rfqLines            PurchaseRFQLine[]
  supplierPriceBreaks SupplierPriceBreak[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model ProductSource {
  id          Int      @id @default(autoincrement())
  productId   Int
  supplier    String
  externalSku String?
  rawData     Json
  price       Float?
  currency    String?
  stock       Json?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId, supplier])
}

model Client {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(255)
  description String?
  imageUrl    String?        @db.VarChar(500)
  companyId   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("clients")
}

model Project {
  id         Int            @id @default(autoincrement())
  slug       String         @db.VarChar(120)
  title      String         @db.VarChar(220)
  sector     String         @db.VarChar(180)
  summary    String?
  impact     String?        @db.VarChar(255)
  services   String[]
  tags       String[]
  highlights String[]
  mainImage  String?        @db.VarChar(500)
  gallery    String[]
  companyId  Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("projects")
}

enum WorkProjectStatus {
  IN_PROGRESS
  AT_RISK
  ON_HOLD
  COMPLETED
}

enum OperationalProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ServiceProjectType {
  INSTALACION_CCTV
  CABLEADO_ESTRUCTURADO
  CONTROL_ACCESO
  REDES_WIFI
  COMPUTO
  AUDITORIA_NODOS
  MANTENIMIENTO
  SUSTITUCION_EQUIPOS
  PROYECTO_INTEGRAL
  OTRO
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  LABOR
  BUNDLE
}

enum ActivityType {
  INTERNAL
  CLIENT
}

model OperationalProject {
  id             Int                      @id @default(autoincrement())
  title          String                   @db.VarChar(220)
  description    String?
  projectType    ServiceProjectType       @default(OTRO)
  scopeSummary   String?
  siteCount      Int?
  /// Vínculo 1:1 con el proyecto comercial (CRM). Misma entrega, dos facetas.
  salesProjectId Int?                     @unique
  status         OperationalProjectStatus @default(ACTIVE)
  vendorId       Int
  clientId       Int
  companyId      Int
  startDate      DateTime
  endDate        DateTime?
  actualEndDate  DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  vendor              User                 @relation("ProjectVendor", fields: [vendorId], references: [id])
  client              ServiceClient        @relation(fields: [clientId], references: [id])
  company             CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  salesProject        SalesProject?        @relation("SalesOperationalHandoff", fields: [salesProjectId], references: [id], onDelete: SetNull)
  engineers           ProjectEngineer[]
  activities          Activity[]
  maintenanceContract MaintenanceContract? @relation("MaintenanceContractProject")

  @@index([vendorId])
  @@index([clientId])
  @@index([companyId])
  @@index([status])
  @@map("operational_projects")
}

model ProjectEngineer {
  id         Int      @id @default(autoincrement())
  projectId  Int
  engineerId Int
  assignedAt DateTime @default(now())

  project  OperationalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engineer User               @relation("ProjectEngineers", fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([projectId, engineerId])
  @@index([projectId])
  @@index([engineerId])
  @@map("project_engineers")
}

model WorkProject {
  id          Int                  @id @default(autoincrement())
  title       String               @db.VarChar(220)
  clientName  String?              @db.VarChar(180)
  managerName String?              @db.VarChar(180)
  status      WorkProjectStatus    @default(IN_PROGRESS)
  startDate   DateTime?
  endDate     DateTime?
  budgetTotal Decimal?             @db.Decimal(12, 2)
  budgetUsed  Decimal?             @db.Decimal(12, 2)
  progress    Int?                 @default(0)
  description String?
  companyId   Int
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  expenses    WorkProjectExpense[]
  payroll     WorkProjectPayroll[]
  logs        WorkProjectLog[]
  company     CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("work_projects")
}

model WorkProjectExpense {
  id         Int            @id @default(autoincrement())
  projectId  Int
  category   String         @db.VarChar(120)
  amount     Decimal        @db.Decimal(12, 2)
  incurredAt DateTime       @default(now())
  note       String?
  companyId  Int
  project    WorkProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("work_project_expenses")
}

model WorkProjectPayroll {
  id        Int            @id @default(autoincrement())
  projectId Int
  employee  String         @db.VarChar(160)
  amount    Decimal        @db.Decimal(12, 2)
  paidAt    DateTime       @default(now())
  note      String?
  companyId Int
  project   WorkProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("work_project_payroll")
}

model WorkProjectLog {
  id        Int            @id @default(autoincrement())
  projectId Int
  label     String         @db.VarChar(160)
  progress  Int?           @default(0)
  note      String?
  createdAt DateTime       @default(now())
  companyId Int
  project   WorkProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("work_project_logs")
}

model ProductCT {
  id                Int               @id @default(autoincrement())
  idProducto        Int?
  clave             String?           @db.VarChar(100)
  numParte          String?           @db.VarChar(100)
  nombre            String?           @db.VarChar(500)
  modelo            String?           @db.VarChar(100)
  idMarca           Int?
  marca             String?           @db.VarChar(200)
  idSubCategoria    Int?
  subcategoria      String?           @db.VarChar(200)
  idCategoria       Int?
  categoria         String?           @db.VarChar(200)
  descripcion_corta String?
  ean               String?           @db.VarChar(100)
  upc               String?           @db.VarChar(100)
  sustituto         String?           @db.VarChar(100)
  activo            Boolean           @default(true)
  protegido         Boolean           @default(false)
  existencia        Json?
  precio            Float?
  moneda            String?           @db.VarChar(10)
  tipoCambio        Float?
  especificaciones  Json?
  promociones       Json?
  imagen            String?           @db.VarChar(500)
  brandId           Int?
  name              String?           @db.VarChar(500)
  description       String?
  imageUrl          String?           @db.VarChar(500)
  thumbnailUrl      String?           @db.VarChar(500)
  icecatId          String?           @db.VarChar(100)
  icecatDatasheet   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  orderItems        OrderItem[]
  brand             Brand?            @relation(fields: [brandId], references: [id])
  supplierProducts  SupplierProduct[]

  @@unique([clave])
  @@index([numParte, idMarca])
  @@index([idProducto])
  @@index([marca])
  @@index([categoria])
  @@index([nombre])
  @@map("productos_ct")
}

/// Corridas de sync de catálogo mayorista (CT FTP, futuros conectores).
model SupplierCatalogSyncRun {
  id             Int       @id @default(autoincrement())
  supplierCode   String    @db.VarChar(40)
  source         String    @db.VarChar(20)
  status         String    @db.VarChar(20)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  rowsRead       Int       @default(0)
  rowsUpserted   Int       @default(0)
  error          String?
  fileModifiedAt String?   @db.VarChar(80)
  checksum       String?   @db.VarChar(64)
  companyId      Int?
  company        CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([supplierCode, startedAt])
  @@index([companyId])
  @@map("supplier_catalog_sync_runs")
}

model Brand {
  id         Int            @id @default(autoincrement())
  name       String         @db.VarChar(200)
  normalized String         @db.VarChar(200)
  companyId  Int
  createdAt  DateTime       @default(now())
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products   Product[]
  productCTs ProductCT[]

  @@unique([companyId, name])
  @@unique([companyId, normalized])
  @@index([companyId])
  @@map("brands")
}

model Supplier {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  apiUrl      String? @db.VarChar(500)
  description String?
  isActive    Boolean @default(true)
  /// RFC del proveedor — requerido para DIOT y Contabilidad Electrónica.
  rfc         String? @db.VarChar(13)

  // === Condiciones de mayorista ===
  // El organigrama nombra "Compras con Mayorista" como función propia de
  // Administración, pero el esquema trataba igual al mayorista con el que hay
  // convenio y al proveedor de una sola compra: sin crédito pactado, sin
  // escalones de precio y sin tiempo de entrega comprometido.
  /// Distingue al mayorista con convenio del proveedor puntual.
  esMayorista   Boolean  @default(false)
  /// Días de crédito pactados. 0 o null = pago de contado.
  creditoDias   Int?
  /// Tope de saldo por pagar. Al superarse, la orden avisa antes de emitirse.
  limiteCredito Decimal? @db.Decimal(14, 2)
  /// Descuento de convenio aplicable cuando no hay escalón por volumen.
  descuentoBase Decimal? @db.Decimal(5, 2)
  /// Tiempo de entrega comprometido, en días.
  leadTimeDias  Int?
  /// Importe mínimo por pedido exigido por el mayorista.
  pedidoMinimo  Decimal? @db.Decimal(14, 2)

  companyId        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  orderItems       OrderItem[]
  supplierProducts SupplierProduct[]
  cotizacionItems  CotizacionItem[]

  // === ERP Industrial Relations ===
  invoices       Invoice[]            @relation("SupplierInvoices")
  lots           Lot[]                @relation("LotSupplier")
  purchaseOrders PurchaseOrder[]      @relation("SupplierPurchaseOrders")
  evaluations    SupplierEvaluation[] @relation("SupplierEvaluations")
  rfqLines       PurchaseRFQLine[]    @relation("SupplierRFQLines")
  priceBreaks    SupplierPriceBreak[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("suppliers")
}

model SupplierProduct {
  id          Int       @id @default(autoincrement())
  supplierId  Int
  productId   Int
  supplierSku String    @db.VarChar(150)
  price       Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0)
  active      Boolean   @default(true)
  leadTime    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  currency    String    @db.VarChar(10)
  product     ProductCT @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@map("supplier_products")
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int?
  email     String      @db.VarChar(255)
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  productId  Int
  supplierId Int
  quantity   Int
  price      Decimal   @db.Decimal(10, 2)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    ProductCT @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Role {
  id                    Int     @id @default(autoincrement())
  nombre                String  @unique @db.VarChar(50)
  nivelAutoridad        Int     @default(0)
  accesoConsole         Boolean @default(false)
  accesoConsoleAdmin    Boolean @default(false)
  accesoActividades     Boolean @default(false)
  accesoEvidencias      Boolean @default(false)
  accesoViaticos        Boolean @default(false)
  accesoVehiculos       Boolean @default(false)
  accesoAsistencia      Boolean @default(false)
  accesoGps             Boolean @default(false)
  accesoGestionUsuarios Boolean @default(false)
  accesoGestionTienda   Boolean @default(false)
  accesoGestionWeb      Boolean @default(false)
  accesoGestionCvs      Boolean @default(false)
  accesoPanelVentas     Boolean @default(false)
  accesoContabilidad    Boolean @default(false)
  accesoCotizaciones    Boolean @default(false)

  // === ERP Industrial Access ===
  accesoInventario    Boolean @default(false)
  accesoCompras       Boolean @default(false)
  accesoManufactura   Boolean @default(false)
  accesoCalidad       Boolean @default(false)
  accesoMantenimiento Boolean @default(false)
  accesoSeguridad     Boolean @default(false)
  accesoDocumentos    Boolean @default(false)
  accesoWorkflow      Boolean @default(false)
  accesoAuditoria     Boolean @default(false)
  accesoBI            Boolean @default(false)
  accesoBanca         Boolean @default(false)
  accesoMultas        Boolean @default(false)
  accesoClientes      Boolean @default(false)
  accesoLunchBreaks   Boolean @default(false)
  accesoRRHH          Boolean @default(false)
  accesoCatalogo      Boolean @default(false)
  orgRoleKey          String? @db.VarChar(40)

  users User[]

  // === ERP Industrial Relations ===
  workflowSteps WorkflowStep[] @relation("WorkflowStepRole")
}

model Department {
  id        Int            @id @default(autoincrement())
  nombre    String         @db.VarChar(100)
  companyId Int
  users     User[]
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // === ERP Industrial Relations ===
  costCenters          CostCenter[]
  purchaseRequisitions PurchaseRequisition[]

  @@unique([companyId, nombre])
  @@index([companyId])
}

model User {
  id                        Int                        @id @default(autoincrement())
  nombre                    String                     @db.VarChar(100)
  email                     String                     @unique @db.VarChar(150)
  employeeNumber            String?                    @db.VarChar(30)
  passwordHash              String
  roleId                    Int
  // RBAC v2 — clave de rol normalizada (super_admin, ceo, dir_admin, …)
  // Coexiste con roleId/Role mientras dura la migración. Fuente de verdad
  // para UrlAccessGuard y canOpenPage().  Ver apps/api/src/common/rbac/roles.v2.ts
  roleKey                   String?                    @db.VarChar(40)
  departmentId              Int
  fechaCreacion             DateTime                   @default(now())
  avatarUrl                 String?                    @db.VarChar(500)
  locationConsent           Boolean                    @default(false)
  // ── Campos RRHH ─────────────────────────────────────────
  puesto                    String?                    @db.VarChar(120)
  tipoContrato              String?                    @db.VarChar(30)
  estadoRRHH                String?                    @default("Activo") @db.VarChar(30)
  isActive                  Boolean                    @default(true)
  fechaIngreso              DateTime?
  // ── IAM / seguridad de acceso ───────────────────────────
  lastLoginAt               DateTime?
  lastLoginIp               String?                    @db.VarChar(45)
  lastLoginDevice           String?                    @db.VarChar(255)
  failedLoginCount          Int                        @default(0)
  lockedUntil               DateTime?
  passwordChangedAt         DateTime?
  mfaEnabled                Boolean                    @default(false)
  mfaSecret                 String?                    @db.VarChar(64)
  mfaEnabledAt              DateTime?
  oidcProvider              String?                    @db.VarChar(40)
  oidcSubject               String?                    @db.VarChar(190)
  perfil                    UserProfile?
  documentos                UserDocument[]
  documentosRevisados       UserDocument[]             @relation("UserDocumentReviewer")
  perfilesRevisados         UserProfile[]              @relation("UserProfileReviewer")
  actividadesCreadas        Activity[]                 @relation("CreadorActividades")
  actividadesAsignadas      Activity[]                 @relation("ResponsableActividades")
  evidencias                Evidence[]
  evidenciasAprobadas       Evidence[]                 @relation("EvidenceApprover")
  vehiculosRevisados        VehicleControl[]           @relation("VehicleDeliveryReviewer")
  vehicleAssetsAssigned     VehicleAsset[]             @relation("VehicleAssetAssigned")
  expenses                  Expense[]
  expensesCreated           Expense[]                  @relation("ExpenseCreator")
  locations                 LocationTracking[]
  department                Department                 @relation(fields: [departmentId], references: [id])
  role                      Role                       @relation(fields: [roleId], references: [id])
  vehicleControls           VehicleControl[]           @relation("SolicitanteVehiculo")
  Viatico                   Viatico[]
  viaticosAsignados         Viatico[]                  @relation("ViaticoAsignadoPor")
  attendances               Attendance[]
  attendanceDays            AttendanceDay[]
  lunchBreaks               LunchBreak[]
  employeePayments          EmployeePayment[]
  employeePaymentsCreated   EmployeePayment[]          @relation("EmployeePaymentCreator")
  cotizaciones              Cotizacion[]
  cotizacionVersions        CotizacionVersion[]
  supplierPurchaseOrders    SupplierPurchaseOrder[]
  salesClientsManaged       SalesClient[]              @relation("SalesClientOwner")
  salesClientDocuments      SalesClientDocument[]      @relation("SalesClientDocumentUploader")
  salesLeadsCreated         SalesLead[]                @relation("SalesLeadCreator")
  salesLeadsOwned           SalesLead[]                @relation("SalesLeadOwner")
  salesOpportunitiesOwned   SalesOpportunity[]         @relation("SalesOpportunityOwner")
  salesOpportunityNotes     SalesOpportunityNote[]     @relation("SalesOpportunityNoteCreator")
  salesOpportunityEvidences SalesOpportunityEvidence[] @relation("SalesOpportunityEvidenceCreator")
  salesOpportunityQuotes    SalesOpportunityQuote[]    @relation("SalesOpportunityQuoteCreator")
  salesProjectOrdersCreated SalesProjectOrder[]        @relation("SalesProjectOrderCreator")
  orderTemplates            OrderTemplate[]            @relation("OrderTemplateCreator")
  salesAuditEvents          SalesAuditEvent[]          @relation("SalesAuditActor")
  notifications             Notification[]
  notificationsTriggered    Notification[]             @relation("NotificationTriggeredBy")
  reviewedEvidences         ActivityEvidence[] // Evidencias revisadas por este usuario
  fines                     Fine[]
  toolRequests              ToolRequest[]              @relation("UserToolRequests")
  approvedToolRequests      ToolRequest[]              @relation("AdminApprovals")
  toolRenewalsApproved      ToolRenewal[]              @relation("AdminRenewals")
  toolNotifications         ToolRequestNotification[]  @relation("ToolNotifications")
  toolInventoryCreated      ToolInventoryItem[]        @relation("ToolInventoryCreatedBy")
  toolInventoryUpdated      ToolInventoryItem[]        @relation("ToolInventoryUpdatedBy")
  toolKitAssignments        ToolKitAssignment[]        @relation("ToolKitUserAssignments")
  toolKitAssignmentsCreated ToolKitAssignment[]        @relation("ToolKitAssignedBy")
  toolKitEventsReported     ToolKitEvent[]             @relation("ToolKitEventReportedBy")
  toolKitEventsResolved     ToolKitEvent[]             @relation("ToolKitEventResolvedBy")
  cvsCreated                CvCandidate[]              @relation("CvCreatedBy")
  cvsRecruiterReviewed      CvCandidate[]              @relation("CvRecruiterReviewedBy")
  cvsAdminReviewed          CvCandidate[]              @relation("CvAdminReviewedBy")
  cvsSuperadminReviewed     CvCandidate[]              @relation("CvSuperadminReviewedBy")
  companyMemberships        UserCompany[]
  participacionesActividad  ActivityAssignee[]         @relation("ActivityAssignedUser")
  reasignacionesDesde       ActivityReassignment[]     @relation("ActivityReassignFrom")
  reasignacionesHacia       ActivityReassignment[]     @relation("ActivityReassignTo")
  reasignacionesHechas      ActivityReassignment[]     @relation("ActivityReassignBy")
  incidenciasReportadas     ActivityIncident[]         @relation("IncidentReporter")
  incidenciasResueltas      ActivityIncident[]         @relation("IncidentResolver")
  recomendacionesHechas     ActivityRecommendation[]   @relation("RecommendationAuthor")
  reunionesFacilitadas      OperationalMeeting[]       @relation("MeetingFacilitator")
  asistenciasReunion        MeetingAttendee[]
  acuerdosAsignados         MeetingAgreement[]         @relation("AgreementOwner")

  // === ERP Industrial Relations ===
  fiscalPeriodsClosed       FiscalPeriod[]             @relation("FiscalPeriodClosedBy")
  journalEntriesCreated     JournalEntry[]             @relation("JournalEntryCreator")
  invoicesCreated           Invoice[]                  @relation("InvoiceCreator")
  invoicesMatched           Invoice[]                  @relation("InvoiceMatcher")
  paymentsCreated           Payment[]                  @relation("PaymentCreator")
  reconciliations           BankReconciliation[]       @relation("ReconciliationUser")
  warehousesManaged         Warehouse[]                @relation("WarehouseManager")
  stockMovementsCreated     StockMovement[]            @relation("StockMovementCreator")
  requisitionsRequested     PurchaseRequisition[]      @relation("RequisitionRequester")
  requisitionsApproved      PurchaseRequisition[]      @relation("RequisitionApprover")
  purchaseOrdersCreated     PurchaseOrder[]            @relation("PurchaseOrderCreator")
  purchaseOrdersApproved    PurchaseOrder[]            @relation("PurchaseOrderApprover")
  goodsReceiptsReceived     GoodsReceipt[]             @relation("GoodsReceiptReceiver")
  supplierEvaluations       SupplierEvaluation[]       @relation("SupplierEvaluator")
  bomsApproved              BillOfMaterials[]          @relation("BOMApprover")
  productionOrdersCreated   ProductionOrder[]          @relation("ProductionOrderCreator")
  productionLogs            ProductionLog[]            @relation("ProductionLogOperator")
  qualityInspections        QualityInspection[]        @relation("QualityInspector")
  ncrsReported              NonConformanceReport[]     @relation("NCRReportedBy")
  cycleCountsCreated        CycleCount[]               @relation("CycleCountCreator")
  cycleCountsClosed         CycleCount[]               @relation("CycleCountCloser")
  stockReservationsCreated  StockReservation[]         @relation("StockReservationCreator")
  purchaseRfqsCreated       PurchaseRFQ[]              @relation("PurchaseRFQCreator")
  ncrsAssigned              NonConformanceReport[]     @relation("NCRAssignedTo")
  assetsResponsible         Asset[]                    @relation("AssetResponsible")
  maintenanceAssigned       MaintenanceOrder[]         @relation("MaintenanceAssignee")
  maintenanceCreated        MaintenanceOrder[]         @relation("MaintenanceCreator")
  maintenanceContractsOwned MaintenanceContract[]      @relation("MaintenanceContractOwner")
  maintenanceVisitsAssigned MaintenanceContractVisit[] @relation("MaintenanceVisitAssignee")
  tendersOwned              Tender[]                   @relation("TenderOwner")
