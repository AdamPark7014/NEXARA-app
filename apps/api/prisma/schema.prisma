generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              Int             @id @default(autoincrement())
  sku             String          @unique
  name            String
  description     String?
  specifications  Json?
  imageUrl        String?
  category        String?
  subcategory     String?
  price           Float?
  currency        String?
  icecatId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  brandId         Int?
  ean             String?
  icecatDatasheet String?
  thumbnailUrl    String?
  upc             String?
  activo          Boolean?        @default(true)
  existencia      Json?
  promociones     Json?
  protegido       Boolean?        @default(false)
  sustituto       String?
  tipoCambio      Float?
  brand           Brand?          @relation(fields: [brandId], references: [id])
  sources         ProductSource[]

  // === ERP Industrial Relations ===
  invoiceItems       InvoiceItem[]
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  lots               Lot[]
  purchaseReqItems   PurchaseRequisitionItem[]
  purchaseOrderItems PurchaseOrderItem[]
  boms               BillOfMaterials[]         @relation("ProductBOM")
  bomComponents      BOMComponent[]            @relation("BOMComponentProduct")
  productionOrders   ProductionOrder[]
  qualityInspections QualityInspection[]
  ncrs               NonConformanceReport[]
  maintenanceParts   MaintenanceOrderPart[]
}

model ProductSource {
  id          Int      @id @default(autoincrement())
  productId   Int
  supplier    String
  externalSku String?
  rawData     Json
  price       Float?
  currency    String?
  stock       Json?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId, supplier])
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?
  imageUrl    String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("clients")
}

model Project {
  id         Int      @id @default(autoincrement())
  slug       String   @unique @db.VarChar(120)
  title      String   @db.VarChar(220)
  sector     String   @db.VarChar(180)
  summary    String?
  impact     String?  @db.VarChar(255)
  services   String[]
  tags       String[]
  highlights String[]
  mainImage  String?  @db.VarChar(500)
  gallery    String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("projects")
}

enum WorkProjectStatus {
  IN_PROGRESS
  AT_RISK
  ON_HOLD
  COMPLETED
}

enum OperationalProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ActivityType {
  INTERNAL
  CLIENT
}

model OperationalProject {
  id            Int                      @id @default(autoincrement())
  title         String                   @db.VarChar(220)
  description   String?
  status        OperationalProjectStatus @default(ACTIVE)
  vendorId      Int
  clientId      Int
  startDate     DateTime
  endDate       DateTime?
  actualEndDate DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?

  vendor     User              @relation("ProjectVendor", fields: [vendorId], references: [id])
  client     ServiceClient     @relation(fields: [clientId], references: [id])
  engineers  ProjectEngineer[]
  activities Activity[]

  @@index([vendorId])
  @@index([clientId])
  @@index([status])
  @@map("operational_projects")
}

model ProjectEngineer {
  id         Int      @id @default(autoincrement())
  projectId  Int
  engineerId Int
  assignedAt DateTime @default(now())

  project  OperationalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engineer User               @relation("ProjectEngineers", fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([projectId, engineerId])
  @@index([projectId])
  @@index([engineerId])
  @@map("project_engineers")
}

model WorkProject {
  id          Int                  @id @default(autoincrement())
  title       String               @db.VarChar(220)
  clientName  String?              @db.VarChar(180)
  managerName String?              @db.VarChar(180)
  status      WorkProjectStatus    @default(IN_PROGRESS)
  startDate   DateTime?
  endDate     DateTime?
  budgetTotal Decimal?             @db.Decimal(12, 2)
  budgetUsed  Decimal?             @db.Decimal(12, 2)
  progress    Int?                 @default(0)
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  expenses    WorkProjectExpense[]
  payroll     WorkProjectPayroll[]
  logs        WorkProjectLog[]

  @@map("work_projects")
}

model WorkProjectExpense {
  id         Int         @id @default(autoincrement())
  projectId  Int
  category   String      @db.VarChar(120)
  amount     Decimal     @db.Decimal(12, 2)
  incurredAt DateTime    @default(now())
  note       String?
  project    WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_project_expenses")
}

model WorkProjectPayroll {
  id        Int         @id @default(autoincrement())
  projectId Int
  employee  String      @db.VarChar(160)
  amount    Decimal     @db.Decimal(12, 2)
  paidAt    DateTime    @default(now())
  note      String?
  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_project_payroll")
}

model WorkProjectLog {
  id        Int         @id @default(autoincrement())
  projectId Int
  label     String      @db.VarChar(160)
  progress  Int?        @default(0)
  note      String?
  createdAt DateTime    @default(now())
  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_project_logs")
}

model ProductCT {
  id                Int               @id @default(autoincrement())
  idProducto        Int?
  clave             String?           @db.VarChar(100)
  numParte          String?           @db.VarChar(100)
  nombre            String?           @db.VarChar(500)
  modelo            String?           @db.VarChar(100)
  idMarca           Int?
  marca             String?           @db.VarChar(200)
  idSubCategoria    Int?
  subcategoria      String?           @db.VarChar(200)
  idCategoria       Int?
  categoria         String?           @db.VarChar(200)
  descripcion_corta String?
  ean               String?           @db.VarChar(100)
  upc               String?           @db.VarChar(100)
  sustituto         String?           @db.VarChar(100)
  activo            Boolean           @default(true)
  protegido         Boolean           @default(false)
  existencia        Json?
  precio            Float?
  moneda            String?           @db.VarChar(10)
  tipoCambio        Float?
  especificaciones  Json?
  promociones       Json?
  imagen            String?           @db.VarChar(500)
  brandId           Int?
  name              String?           @db.VarChar(500)
  description       String?
  imageUrl          String?           @db.VarChar(500)
  thumbnailUrl      String?           @db.VarChar(500)
  icecatId          String?           @db.VarChar(100)
  icecatDatasheet   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  orderItems        OrderItem[]
  brand             Brand?            @relation(fields: [brandId], references: [id])
  supplierProducts  SupplierProduct[]

  @@index([numParte, idMarca])
  @@map("productos_ct")
}

model Brand {
  id         Int         @id @default(autoincrement())
  name       String      @unique @db.VarChar(200)
  normalized String      @unique @db.VarChar(200)
  createdAt  DateTime    @default(now())
  products   Product[]
  productCTs ProductCT[]

  @@map("brands")
}

model Supplier {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(255)
  apiUrl           String?           @db.VarChar(500)
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orderItems       OrderItem[]
  supplierProducts SupplierProduct[]

  // === ERP Industrial Relations ===
  invoices       Invoice[]            @relation("SupplierInvoices")
  lots           Lot[]                @relation("LotSupplier")
  purchaseOrders PurchaseOrder[]      @relation("SupplierPurchaseOrders")
  evaluations    SupplierEvaluation[] @relation("SupplierEvaluations")

  @@map("suppliers")
}

model SupplierProduct {
  id          Int       @id @default(autoincrement())
  supplierId  Int
  productId   Int
  supplierSku String    @db.VarChar(150)
  price       Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0)
  active      Boolean   @default(true)
  leadTime    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  currency    String    @db.VarChar(10)
  product     ProductCT @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@map("supplier_products")
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int?
  email     String      @db.VarChar(255)
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  productId  Int
  supplierId Int
  quantity   Int
  price      Decimal   @db.Decimal(10, 2)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    ProductCT @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Role {
  id                    Int     @id @default(autoincrement())
  nombre                String  @unique @db.VarChar(50)
  nivelAutoridad        Int     @default(0)
  accesoConsole         Boolean @default(false)
  accesoConsoleAdmin    Boolean @default(false)
  accesoActividades     Boolean @default(false)
  accesoEvidencias      Boolean @default(false)
  accesoViaticos        Boolean @default(false)
  accesoVehiculos       Boolean @default(false)
  accesoAsistencia      Boolean @default(false)
  accesoGps             Boolean @default(false)
  accesoGestionUsuarios Boolean @default(false)
  accesoGestionTienda   Boolean @default(false)
  accesoGestionWeb      Boolean @default(false)
  accesoGestionCvs      Boolean @default(false)
  accesoPanelVentas     Boolean @default(false)
  accesoContabilidad    Boolean @default(false)
  accesoCotizaciones    Boolean @default(false)

  // === ERP Industrial Access ===
  accesoInventario    Boolean @default(false)
  accesoCompras       Boolean @default(false)
  accesoManufactura   Boolean @default(false)
  accesoCalidad       Boolean @default(false)
  accesoMantenimiento Boolean @default(false)
  accesoSeguridad     Boolean @default(false)
  accesoDocumentos    Boolean @default(false)
  accesoWorkflow      Boolean @default(false)
  accesoAuditoria     Boolean @default(false)
  accesoBI            Boolean @default(false)
  accesoBanca         Boolean @default(false)
  accesoMultas        Boolean @default(false)
  accesoClientes      Boolean @default(false)
  accesoLunchBreaks   Boolean @default(false)

  users User[]

  // === ERP Industrial Relations ===
  workflowSteps WorkflowStep[] @relation("WorkflowStepRole")
}

model Department {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)
  users  User[]

  // === ERP Industrial Relations ===
  costCenters          CostCenter[]
  purchaseRequisitions PurchaseRequisition[]
}

model User {
  id                        Int                        @id @default(autoincrement())
  nombre                    String                     @db.VarChar(100)
  email                     String                     @unique @db.VarChar(150)
  employeeNumber            String?                    @unique @db.VarChar(30)
  passwordHash              String
  roleId                    Int
  departmentId              Int
  fechaCreacion             DateTime                   @default(now())
  avatarUrl                 String?                    @db.VarChar(500)
  locationConsent           Boolean                    @default(false)
  perfil                    UserProfile?
  documentos                UserDocument[]
  documentosRevisados       UserDocument[]             @relation("UserDocumentReviewer")
  perfilesRevisados         UserProfile[]              @relation("UserProfileReviewer")
  actividadesCreadas        Activity[]                 @relation("CreadorActividades")
  actividadesAsignadas      Activity[]                 @relation("ResponsableActividades")
  evidencias                Evidence[]
  evidenciasAprobadas       Evidence[]                 @relation("EvidenceApprover")
  vehiculosRevisados        VehicleControl[]           @relation("VehicleDeliveryReviewer")
  expenses                  Expense[]
  locations                 LocationTracking[]
  department                Department                 @relation(fields: [departmentId], references: [id])
  role                      Role                       @relation(fields: [roleId], references: [id])
  vehicleControls           VehicleControl[]           @relation("SolicitanteVehiculo")
  Viatico                   Viatico[]
  attendances               Attendance[]
  attendanceDays            AttendanceDay[]
  lunchBreaks               LunchBreak[]
  employeePayments          EmployeePayment[]
  employeePaymentsCreated   EmployeePayment[]          @relation("EmployeePaymentCreator")
  cotizaciones              Cotizacion[]
  salesClientsManaged       SalesClient[]              @relation("SalesClientOwner")
  salesClientDocuments      SalesClientDocument[]      @relation("SalesClientDocumentUploader")
  salesLeadsCreated         SalesLead[]                @relation("SalesLeadCreator")
  salesLeadsOwned           SalesLead[]                @relation("SalesLeadOwner")
  salesOpportunitiesOwned   SalesOpportunity[]         @relation("SalesOpportunityOwner")
  salesOpportunityNotes     SalesOpportunityNote[]     @relation("SalesOpportunityNoteCreator")
  salesOpportunityEvidences SalesOpportunityEvidence[] @relation("SalesOpportunityEvidenceCreator")
  salesOpportunityQuotes    SalesOpportunityQuote[]    @relation("SalesOpportunityQuoteCreator")
  salesProjectOrdersCreated SalesProjectOrder[]        @relation("SalesProjectOrderCreator")
  orderTemplates            OrderTemplate[]            @relation("OrderTemplateCreator")
  salesAuditEvents          SalesAuditEvent[]          @relation("SalesAuditActor")
  notifications             Notification[]
  notificationsTriggered    Notification[]             @relation("NotificationTriggeredBy")
  reviewedEvidences         ActivityEvidence[] // Evidencias revisadas por este usuario
  fines                     Fine[]
  toolRequests              ToolRequest[]              @relation("UserToolRequests")
  approvedToolRequests      ToolRequest[]              @relation("AdminApprovals")
  toolRenewalsApproved      ToolRenewal[]              @relation("AdminRenewals")
  toolNotifications         ToolRequestNotification[]  @relation("ToolNotifications")
  toolInventoryCreated      ToolInventoryItem[]        @relation("ToolInventoryCreatedBy")
  toolInventoryUpdated      ToolInventoryItem[]        @relation("ToolInventoryUpdatedBy")
  toolKitAssignments        ToolKitAssignment[]        @relation("ToolKitUserAssignments")
  toolKitAssignmentsCreated ToolKitAssignment[]        @relation("ToolKitAssignedBy")
  toolKitEventsReported     ToolKitEvent[]             @relation("ToolKitEventReportedBy")
  toolKitEventsResolved     ToolKitEvent[]             @relation("ToolKitEventResolvedBy")
  cvsCreated                CvCandidate[]              @relation("CvCreatedBy")
  cvsRecruiterReviewed      CvCandidate[]              @relation("CvRecruiterReviewedBy")
  cvsAdminReviewed          CvCandidate[]              @relation("CvAdminReviewedBy")
  cvsSuperadminReviewed     CvCandidate[]              @relation("CvSuperadminReviewedBy")

  // === ERP Industrial Relations ===
  fiscalPeriodsClosed     FiscalPeriod[]         @relation("FiscalPeriodClosedBy")
  journalEntriesCreated   JournalEntry[]         @relation("JournalEntryCreator")
  invoicesCreated         Invoice[]              @relation("InvoiceCreator")
  paymentsCreated         Payment[]              @relation("PaymentCreator")
  reconciliations         BankReconciliation[]   @relation("ReconciliationUser")
  warehousesManaged       Warehouse[]            @relation("WarehouseManager")
  stockMovementsCreated   StockMovement[]        @relation("StockMovementCreator")
  requisitionsRequested   PurchaseRequisition[]  @relation("RequisitionRequester")
  requisitionsApproved    PurchaseRequisition[]  @relation("RequisitionApprover")
  purchaseOrdersCreated   PurchaseOrder[]        @relation("PurchaseOrderCreator")
  purchaseOrdersApproved  PurchaseOrder[]        @relation("PurchaseOrderApprover")
  goodsReceiptsReceived   GoodsReceipt[]         @relation("GoodsReceiptReceiver")
  supplierEvaluations     SupplierEvaluation[]   @relation("SupplierEvaluator")
  bomsApproved            BillOfMaterials[]      @relation("BOMApprover")
  productionOrdersCreated ProductionOrder[]      @relation("ProductionOrderCreator")
  productionLogs          ProductionLog[]        @relation("ProductionLogOperator")
  qualityInspections      QualityInspection[]    @relation("QualityInspector")
  ncrsReported            NonConformanceReport[] @relation("NCRReportedBy")
  ncrsAssigned            NonConformanceReport[] @relation("NCRAssignedTo")
  assetsResponsible       Asset[]                @relation("AssetResponsible")
  maintenanceAssigned     MaintenanceOrder[]     @relation("MaintenanceAssignee")
  maintenanceCreated      MaintenanceOrder[]     @relation("MaintenanceCreator")
  safetyIncidentsReported SafetyIncident[]       @relation("IncidentReporter")
  safetyIncidentsAssigned SafetyIncident[]       @relation("IncidentAssignee")
  workPermitsRequested    WorkPermit[]           @relation("PermitRequester")
  workPermitsApproved     WorkPermit[]           @relation("PermitApprover")
  trainingRecords         TrainingRecord[]       @relation("UserTraining")
  documentsCreated        ManagedDocument[]      @relation("DocumentCreator")
  documentsApproved       ManagedDocument[]      @relation("DocumentApprover")
  documentVersionsCreated DocumentVersion[]      @relation("DocumentVersionCreator")
  workflowStepsApprover   WorkflowStep[]         @relation("WorkflowStepApprover")
  workflowsStarted        WorkflowInstance[]     @relation("WorkflowStarter")
  workflowApprovals       WorkflowApproval[]     @relation("ApprovalDecider")
  auditLogs               AuditLog[]             @relation("AuditLogUser")
  preferences             UserPreference[]       @relation("UserPreferences")

  // === HR Relations ===
  leaveRequests           LeaveRequest[]      @relation("LeaveRequester")
  leaveApprovals          LeaveRequest[]      @relation("LeaveApprover")
  performanceReviews      PerformanceReview[] @relation("ReviewedUser")
  performanceReviewsGiven PerformanceReview[] @relation("Reviewer")

  // === Operational Project Relations ===
  projectsAsVendor OperationalProject[] @relation("ProjectVendor")
  projectEngineers ProjectEngineer[]    @relation("ProjectEngineers")
}

enum CvEmploymentStatus {
  NEW_CANDIDATE
  CURRENT_EMPLOYEE
  FORMER_EMPLOYEE
}

enum CvStage {
  INBOX
  RECRUITER_SHORTLIST
  RECRUITER_REJECTED
  ADMIN_SHORTLIST
  ADMIN_REJECTED
  SUPERADMIN_SHORTLIST
  SUPERADMIN_REJECTED
  APPROVED
}

enum CvDecision {
  PENDING
  APPROVED
  REJECTED
}

model CvCandidate {
  id                     Int                @id @default(autoincrement())
  fullName               String             @db.VarChar(180)
  email                  String?            @db.VarChar(200)
  whatsapp               String?            @db.VarChar(60)
  category               String             @db.VarChar(120)
  tags                   String[]
  employmentStatus       CvEmploymentStatus @default(NEW_CANDIDATE)
  stage                  CvStage            @default(INBOX)
  recruiterDecision      CvDecision         @default(PENDING)
  adminDecision          CvDecision         @default(PENDING)
  superadminDecision     CvDecision         @default(PENDING)
  recruiterNotes         String?
  adminNotes             String?
  superadminNotes        String?
  cvFileUrl              String             @db.VarChar(500)
  sortOrder              Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  createdById            Int
  recruiterReviewedById  Int?
  adminReviewedById      Int?
  superadminReviewedById Int?
  recruiterReviewedAt    DateTime?
  adminReviewedAt        DateTime?
  superadminReviewedAt   DateTime?
  createdBy              User               @relation("CvCreatedBy", fields: [createdById], references: [id])
  recruiterReviewedBy    User?              @relation("CvRecruiterReviewedBy", fields: [recruiterReviewedById], references: [id])
  adminReviewedBy        User?              @relation("CvAdminReviewedBy", fields: [adminReviewedById], references: [id])
  superadminReviewedBy   User?              @relation("CvSuperadminReviewedBy", fields: [superadminReviewedById], references: [id])

  @@index([stage, category, sortOrder])
  @@index([employmentStatus])
  @@index([createdById])
}

model UserProfile {
  id                         Int       @id @default(autoincrement())
  userId                     Int       @unique
  telefono                   String?   @db.VarChar(30)
  fechaNacimiento            DateTime?
  direccion                  String?
  colonia                    String?
  ciudad                     String?
  estado                     String?
  codigoPostal               String?   @db.VarChar(10)
  pais                       String?   @db.VarChar(50)
  curp                       String?   @db.VarChar(30)
  rfc                        String?   @db.VarChar(20)
  ineNumero                  String?   @db.VarChar(30)
  nss                        String?   @db.VarChar(30)
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?   @db.VarChar(30)
  estatus                    String    @default("Pendiente") @db.VarChar(30)
  observaciones              String?
  aprobadoPorId              Int?
  revisadoEn                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aprobadoPor                User?     @relation("UserProfileReviewer", fields: [aprobadoPorId], references: [id])
}

model UserDocument {
  id            Int       @id @default(autoincrement())
  userId        Int
  tipo          String    @db.VarChar(50)
  archivoUrl    String
  estatus       String    @default("Pendiente") @db.VarChar(30)
  observaciones String?
  aprobadoPorId Int?
  revisadoEn    DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aprobadoPor   User?     @relation("UserDocumentReviewer", fields: [aprobadoPorId], references: [id])
}

model Activity {
  id                      Int                     @id @default(autoincrement())
  anNumber                String                  @unique @db.VarChar(20)
  titulo                  String                  @db.VarChar(200)
  descripcion             String?
  indicaciones            String?
  estatus                 String                  @default("Pendiente") @db.VarChar(50)
  prioridad               String?                 @db.VarChar(20)
  activityType            ActivityType?           @default(CLIENT)
  ticketType              TicketType?             @default(PREVENTIVO)
  ticketTypeCustom        String?                 @db.VarChar(120)
  workType                ActivityWorkType        @default(ISSUE)
  projectId               Int?
  clientId                Int?
  branchName              String?                 @db.VarChar(160)
  branchNumber            String?                 @db.VarChar(60)
  branchCity              String?                 @db.VarChar(120)
  branchState             String?                 @db.VarChar(120)
  branchAddress           String?                 @db.VarChar(220)
  slaAlertedAt            DateTime?
  tiempoEstimadoMin       Int?
  tiempoMaximoMin         Int?
  creadoPorId             Int
  responsableId           Int
  eficienciaScore         Int?
  comentariosFeedback     String?
  fechaAsignacion         DateTime                @default(now())
  fechaInicio             DateTime?
  fechaMaxima             DateTime?
  fechaEntregaEsperada    DateTime?
  fechaFinalizacion       DateTime?
  clientSurveyRequestedAt DateTime?
  clientSurveyCompletedAt DateTime?
  ticketReportUrl         String?                 @db.VarChar(500)
  ticketReportGeneratedAt DateTime?
  creador                 User                    @relation("CreadorActividades", fields: [creadoPorId], references: [id])
  responsable             User                    @relation("ResponsableActividades", fields: [responsableId], references: [id])
  project                 OperationalProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client                  ServiceClient?          @relation(fields: [clientId], references: [id])
  serviceSheet            ServiceSheet?
  evidencias              Evidence[]
  activityEvidence        ActivityEvidence?
  clientTicketRequest     ClientTicketRequest?
  clientFeedback          ClientActivityFeedback?
  expenses                Expense[]
  locations               LocationTracking[]
  vehicleControls         VehicleControl[]
  Viatico                 Viatico[]
  inventorySnapshot       InventorySnapshot?
  deletedAt               DateTime?

  @@index([projectId])
  @@index([clientId])
}

enum ActivityWorkType {
  ISSUE
  PREVENTIVE_INVENTORY
}

enum TicketType {
  PREVENTIVO
  CORRECTIVO
  EMERGENCIA
  INSTALACION
  OTRO
}

model ServiceClient {
  id                  Int                      @id @default(autoincrement())
  name                String                   @db.VarChar(200)
  logoUrl             String?                  @db.VarChar(500)
  contactName         String?                  @db.VarChar(160)
  contactEmail        String?                  @db.VarChar(200)
  contactPhone        String?                  @db.VarChar(60)
  address             String?                  @db.VarChar(220)
  city                String?                  @db.VarChar(120)
  state               String?                  @db.VarChar(120)
  country             String?                  @db.VarChar(80)
  accountCode         String?                  @db.VarChar(80)
  portalEmail         String?                  @unique @db.VarChar(200)
  portalPasswordHash  String?
  reportUrl           String?                  @db.VarChar(500)
  reportGeneratedAt   DateTime?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
