// Nuevo modelo para el flujo de evidencias de actividades (5 pasos)
model ActivityEvidence {
  id         Int @id @default(autoincrement())
  activityId Int @unique

  // Paso 1: Foto de entrada
  entryPhotoUrl        String?   @db.VarChar(500)
  entryLatitude        Decimal?  @db.Decimal(10, 8)
  entryLongitude       Decimal?  @db.Decimal(11, 8)
  entryPhotoUploadedAt DateTime?

  // Paso 2: Evidencias (4-8 fotos)
  evidencePhotos           String[]  @default([]) // Array de URLs
  evidencePhotosUploadedAt DateTime?

  // Paso 3: Hoja de servicio (PDF)
  serviceSheetPdfUrl     String?   @db.VarChar(500)
  serviceSheetUploadedAt DateTime?

  // Paso 4: Plantilla de hoja de servicio interna
  serviceSheetData        Json? // Datos del formulario de plantilla
  serviceSheetCompletedAt DateTime?

  // Paso 5: Foto de salida
  exitPhotoUrl        String?   @db.VarChar(500)
  exitLatitude        Decimal?  @db.Decimal(10, 8)
  exitLongitude       Decimal?  @db.Decimal(11, 8)
  exitPhotoUploadedAt DateTime?

  // Generales
  status      String    @default("ENTRY_PHOTO") @db.VarChar(50) // ENTRY_PHOTO, EVIDENCE_PHOTOS, SERVICE_SHEET_PDF, SERVICE_SHEET_DATA, EXIT_PHOTO, COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Sistema de Revisión y Aprobación
  reviewStatus          String    @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  rejectedStep          String?   @db.VarChar(50) // Cual paso fue rechazado: ENTRY_PHOTO, EVIDENCE_PHOTOS, etc.
  rejectedSteps         Json? // Pasos rechazados (corrección parcial o reinicio completo)
  reviewNotes           String?   @db.Text // Observaciones del revisor
  reviewedAt            DateTime? // Fecha de revisión
  reviewedById          Int? // Usuario que revisó
  correctionSubmittedAt DateTime? // Fecha de corrección del usuario

  activity   Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  companyId  Int
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("activity_evidences")
}

