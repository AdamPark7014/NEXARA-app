// ──────────────────────────────────────────────────────────────────────
// Hero del sitio público — slides editables desde Studio
// ──────────────────────────────────────────────────────────────────────
// Cada slide es una imagen de fondo del carrusel del home (`/`).
// El texto del hero (eyebrow, título, CTAs) NO se edita: vive en
// `apps/web/app/components/HeroCarousel.tsx`. Solo cambian las imágenes
// y opcionalmente su orden, alt-text accesible y un href cuando se
// quiera que el slide entero sea clickeable.
model HeroSlide {
  id             Int            @id @default(autoincrement())
  imageUrl       String         @db.VarChar(500)
  /// Variante móvil del slide (opcional). Si falta, el sitio usa `imageUrl` (desktop).
  imageUrlMobile String?        @db.VarChar(500)
  altText        String?        @db.VarChar(200)
  caption        String?        @db.VarChar(500)
  href           String?        @db.VarChar(500)
  position       Int            @default(0)
  isActive       Boolean        @default(true)
  companyId      Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([position])
  @@index([isActive])
  @@index([companyId])
  @@map("hero_slides")
}

// ──────────────────────────────────────────────────────────────────────
// Video de fondo del Hero del home — alternativa al carrusel de imágenes
// ──────────────────────────────────────────────────────────────────────
// Singleton lógico: solo existe un video "activo" a la vez. Al subir uno
// nuevo se reemplaza el anterior (archivo físico incluido). El campo
// `mediaType` que decide si el hero muestra el carrusel o este video vive
// en `PageContent` (section = "home_hero"), no aquí.
model HeroVideo {
  id             Int            @id @default(autoincrement())
  /// Video desktop (principal). Lo que ya existía antes de variantes móviles.
  videoUrl       String         @db.VarChar(500)
  /// Video móvil (opcional). Si falta, el sitio usa `videoUrl`.
  videoUrlMobile String?        @db.VarChar(500)
  posterUrl      String?        @db.VarChar(500)
  title          String?        @db.VarChar(200)
  isActive       Boolean        @default(true)
  companyId      Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([companyId])
  @@map("hero_video")
}

model PageContent {
  id           Int            @id @default(autoincrement())
  section      String         @db.VarChar(80)
  /// Contenido publicado (sitio público)
  content      Json
  /// Borrador Studio (no afecta sitio hasta publish)
  draftContent Json?
