enum SalesLeadStatus {
  NEW
  QUALIFIED
  NURTURING
  LOST
  CONVERTED
}

enum SalesOpportunityStage {
  DISCOVERY
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSING
  WON
  LOST
}

enum SalesProjectStatus {
  PLANNED
  IN_PROGRESS
  CLOSED
  ON_HOLD
}

model SalesClient {
  id              Int                   @id @default(autoincrement())
  name            String                @db.VarChar(200)
  legalName       String?               @db.VarChar(220)
  taxId           String?               @db.VarChar(40)
  fiscalAddress   String?
  fiscalZipCode   String?               @db.VarChar(5)
  fiscalRegime    String?               @db.VarChar(10)
  billingEmail    String?               @db.VarChar(200)
  billingPhone    String?               @db.VarChar(60)
  industry        String?               @db.VarChar(160)
  website         String?               @db.VarChar(200)
  status          String?               @db.VarChar(80)
  notes           String?               @db.Text
  ownerId         Int?
  serviceClientId Int?
  companyId       Int
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  documents       SalesClientDocument[]
  leads           SalesLead[]
  opportunities   SalesOpportunity[]
  cotizaciones    Cotizacion[]
  owner           User?                 @relation("SalesClientOwner", fields: [ownerId], references: [id])
  serviceClient   ServiceClient?        @relation(fields: [serviceClientId], references: [id])
  company         CompanyProfile        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // === ERP Industrial Relations ===
  invoices Invoice[]

  @@index([companyId])
  @@map("sales_clients")
}

model SalesClientDocument {
  id           Int         @id @default(autoincrement())
  clientId     Int
  type         String      @db.VarChar(120)
  fileUrl      String      @db.VarChar(500)
  fileName     String?     @db.VarChar(220)
  version      Int         @default(1)
  uploadedById Int?
  createdAt    DateTime    @default(now())
  client       SalesClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy   User?       @relation("SalesClientDocumentUploader", fields: [uploadedById], references: [id])

  @@map("sales_client_documents")
}

model SalesLead {
  id            Int                @id @default(autoincrement())
  name          String?            @db.VarChar(180)
  company       String?            @db.VarChar(200)
  email         String?            @db.VarChar(200)
  phone         String?            @db.VarChar(60)
  source        String?            @db.VarChar(160)
  status        SalesLeadStatus    @default(NEW)
  score         Int                @default(0)
  notes         String?            @db.Text
  clientId      Int?
  createdById   Int?
  ownerId       Int?
  companyId     Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  client        SalesClient?       @relation(fields: [clientId], references: [id])
  tenantCompany CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunities SalesOpportunity[]
  createdBy     User?              @relation("SalesLeadCreator", fields: [createdById], references: [id])
  owner         User?              @relation("SalesLeadOwner", fields: [ownerId], references: [id])
  crmActivities CrmActivity[]

  @@index([companyId])
  @@map("sales_leads")
}

model SalesOpportunity {
  id                Int                        @id @default(autoincrement())
  title             String                     @db.VarChar(220)
  description       String?                    @db.Text
  stage             SalesOpportunityStage      @default(DISCOVERY)
  value             Decimal                    @default(0) @db.Decimal(14, 2)
  probability       Int                        @default(0)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  clientId          Int?
  leadId            Int?
  ownerId           Int?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  client            SalesClient?               @relation(fields: [clientId], references: [id])
  lead              SalesLead?                 @relation(fields: [leadId], references: [id])
  owner             User?                      @relation("SalesOpportunityOwner", fields: [ownerId], references: [id])
  notes             SalesOpportunityNote[]
  evidences         SalesOpportunityEvidence[]
  quotes            SalesOpportunityQuote[]
  cotizaciones      Cotizacion[]
  projects          SalesProject[]
  tender            Tender?
  crmActivities     CrmActivity[]
  companyId         Int
  company           CompanyProfile             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("sales_opportunities")
}

model SalesOpportunityNote {
  id            Int              @id @default(autoincrement())
  opportunityId Int
  message       String           @db.Text
  createdById   Int?
  createdAt     DateTime         @default(now())
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("SalesOpportunityNoteCreator", fields: [createdById], references: [id])

  @@map("sales_opportunity_notes")
}

model SalesOpportunityEvidence {
  id            Int              @id @default(autoincrement())
  opportunityId Int
  fileUrl       String           @db.VarChar(500)
  fileName      String?          @db.VarChar(220)
  kind          String?          @db.VarChar(40)
  createdById   Int?
  createdAt     DateTime         @default(now())
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation("SalesOpportunityEvidenceCreator", fields: [createdById], references: [id])

  @@map("sales_opportunity_evidences")
}

model SalesOpportunityQuote {
  id            Int                 @id @default(autoincrement())
  opportunityId Int
  cotizacionId  Int?
  versionLabel  String?             @db.VarChar(80)
  pdfUrl        String?             @db.VarChar(500)
  createdById   Int?
  createdAt     DateTime            @default(now())
  opportunity   SalesOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  cotizacion    Cotizacion?         @relation(fields: [cotizacionId], references: [id])
  createdBy     User?               @relation("SalesOpportunityQuoteCreator", fields: [createdById], references: [id])
  projectOrders SalesProjectOrder[]

  @@map("sales_opportunity_quotes")
}

model SalesProject {
  id                 Int                 @id @default(autoincrement())
  opportunityId      Int
  name               String              @db.VarChar(220)
  projectType        ServiceProjectType  @default(OTRO)
  scopeSummary       String?
  siteCount          Int?
  budget             Decimal             @default(0) @db.Decimal(14, 2)
  costProducts       Decimal             @default(0) @db.Decimal(14, 2)
  costViaticos       Decimal             @default(0) @db.Decimal(14, 2)
  costOperativo      Decimal             @default(0) @db.Decimal(14, 2)
  margin             Decimal             @default(0) @db.Decimal(14, 2)
  status             SalesProjectStatus  @default(PLANNED)
  startDate          DateTime?
  endDate            DateTime?
  closureOrderId     Int?
  companyId          Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  opportunity        SalesOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  closureOrder       SalesProjectOrder?  @relation("ProjectOrder")
  /// Faceta operativa (OPS) del mismo proyecto — 0..1
  operationalProject OperationalProject? @relation("SalesOperationalHandoff")
  viaticos           Viatico[]
  company            CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("sales_projects")
}

model SalesProjectOrder {
  id          Int                     @id @default(autoincrement())
  projectId   Int                     @unique
  orderId     String                  @db.VarChar(40)
  quoteId     Int?
  orderPdfUrl String?                 @db.VarChar(500)
  status      String                  @default("OPEN") @db.VarChar(40)
  templateId  Int?
  createdById Int?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  companyId   Int
  project     SalesProject            @relation("ProjectOrder", fields: [projectId], references: [id], onDelete: Cascade)
  quote       SalesOpportunityQuote?  @relation(fields: [quoteId], references: [id])
  template    OrderTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy   User?                   @relation("SalesProjectOrderCreator", fields: [createdById], references: [id])
  company     CompanyProfile          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines       SalesProjectOrderLine[]
  invoices    Invoice[]

  @@index([companyId])
  @@map("sales_project_orders")
}

model SalesProjectOrderLine {
  id             Int               @id @default(autoincrement())
  orderId        Int
  productId      Int?
  sortOrder      Int               @default(0)
  category       String?           @db.VarChar(120)
  name           String            @db.VarChar(200)
  description    String?
  scope          String?
  brand          String?           @db.VarChar(120)
  model          String?           @db.VarChar(120)
  sku            String?           @db.VarChar(120)
  partNumber     String?           @db.VarChar(120)
  batchReference String?           @db.VarChar(120)
  unit           String?           @db.VarChar(40)
  qty            Int               @default(1)
  unitPrice      Decimal           @default(0) @db.Decimal(12, 2)
  discount       Int               @default(0)
  tax            Int               @default(0)
  ieps           Int               @default(0)
  retention      Int               @default(0)
  laborHours     Decimal           @default(0) @db.Decimal(10, 2)
  laborRate      Decimal           @default(0) @db.Decimal(12, 2)
  warrantyMonths Int               @default(0)
  deliveryTime   String?           @db.VarChar(120)
  countryOrigin  String?           @db.VarChar(80)
  notes          String?
  lineTotal      Decimal           @default(0) @db.Decimal(12, 2)
  createdAt      DateTime          @default(now())
  order          SalesProjectOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  invoiceItem    InvoiceItem?

  @@index([orderId])
  @@map("sales_project_order_lines")
}

model SalesAuditEvent {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   Int?
  actorId    Int?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("SalesAuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("sales_audit_events")
}

model OrderTemplate {
  id              Int                 @id @default(autoincrement())
  name            String              @db.VarChar(200)
  description     String?
  isDefault       Boolean             @default(false)
  headerLogo      String?             @db.VarChar(500)
  headerText      String?             @db.VarChar(500)
  companyName     String?             @db.VarChar(200)
  companyEmail    String?             @db.VarChar(150)
  companyPhone    String?             @db.VarChar(60)
  companyAddress  String?             @db.VarChar(300)
  companyRfc      String?             @db.VarChar(20)
  companyWebsite  String?             @db.VarChar(200)
  footerText      String?             @db.Text
  footerAlignment String              @default("center") @db.VarChar(20)
  primaryColor    String              @default("#0f6ad6") @db.VarChar(20)
  secondaryColor  String              @default("#f5f5f5") @db.VarChar(20)
  textColor       String              @default("#000000") @db.VarChar(20)
  sections        Json?
  customCss       String?             @db.Text
  createdById     Int?
  companyId       Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  orders          SalesProjectOrder[]
  createdBy       User?               @relation("OrderTemplateCreator", fields: [createdById], references: [id])
  company         CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("order_templates")
}

enum NotificationType {
  // ATTENDANCE - Entrada/Salida
  ATTENDANCE_CHECKIN
  ATTENDANCE_CHECKOUT
  ATTENDANCE_ABSENCE
  ATTENDANCE_UPDATE

  // LUNCH BREAKS - Comida
  LUNCH_CHECKIN
  LUNCH_CHECKOUT

  // ACTIVITIES - Actividades
  ACTIVITY_ASSIGNED
  ACTIVITY_APPROVED
  ACTIVITY_REJECTED
  ACTIVITY_RESUBMIT_REQUESTED

  // EVIDENCE - Evidencias
  EVIDENCE_SUBMITTED
  EVIDENCE_APPROVED
  EVIDENCE_REJECTED
  EVIDENCE_RESUBMIT_REQUESTED

  // VIATICOS - Viáticos
  VIATICO_ASSIGNED
  VIATICO_APPROVED
  VIATICO_REJECTED
  VIATICO_PAID

  // TOOLS - Herramientas
  TOOL_REQUESTED
  TOOL_APPROVED
  TOOL_REJECTED
  TOOL_DELIVERED
  TOOL_RETURNED
  TOOL_RENEWAL_REQUESTED
  TOOL_RENEWAL_APPROVED
  TOOL_RENEWAL_REJECTED
  TOOL_EXPIRATION_WARNING
  TOOL_EXPIRATION_DUE

  // FINES - Multas
  FINE_CREATED
  FINE_PAID
  FINE_CANCELLED

  // PROFILE - Perfil
  PROFILE_DOCUMENT_UPLOADED
  PROFILE_DOCUMENT_APPROVED
  PROFILE_DOCUMENT_REJECTED

  // VEHICLES - Vehículos
  VEHICLE_DELIVERY_REQUESTED
  VEHICLE_DELIVERY_APPROVED
  VEHICLE_DELIVERY_REJECTED
  VEHICLE_RENEWAL_REQUESTED
  VEHICLE_RENEWAL_APPROVED
  VEHICLE_RENEWAL_REJECTED

  // QUOTES - Cotizaciones
  QUOTE_EXPIRING
  QUOTE_EXPIRED
  QUOTE_SIGNED

  // ORDERS - Órdenes
  ORDER_CREATED

  // PROJECTS - Proyectos
  PROJECT_COMPLETED

  // SALES / CRM (alertas jerárquicas a dirección)
  SALES_CLIENT_CREATED
  SALES_LEAD_CREATED
  SALES_OPPORTUNITY_CREATED
  SALES_OPPORTUNITY_STAGE_CHANGED

  // Confirmación al usuario que ejecutó la acción
  USER_ACTION_CONFIRMED

  // Actividad marcada como finalizada en campo
  ACTIVITY_COMPLETED

  // Compras / almacén / calidad (ERP)
  PURCHASE_REQUISITION_CREATED
  PURCHASE_REQUISITION_APPROVED
  PURCHASE_REQUISITION_REJECTED
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_APPROVED
  GOODS_RECEIPT_POSTED
  STOCK_MOVEMENT_POSTED
  QUALITY_NCR_CREATED

  // Manufactura / contabilidad / mantenimiento
  PRODUCTION_ORDER_CREATED
  PRODUCTION_ORDER_STATUS_CHANGED
  PRODUCTION_LOG_RECORDED
  JOURNAL_ENTRY_POSTED
  INVOICE_CREATED
  PAYMENT_REGISTERED
  MAINTENANCE_WORK_ORDER_CREATED

  // Alertas cross-módulo (Phase 8)
  MARGIN_ALERT
  SLA_ALERT
  STOCK_ALERT

  // Chat
  CHAT_MENTION
}

model Notification {
  id              Int              @id @default(autoincrement())
  userId          Int
  type            NotificationType
  category        String           @db.VarChar(50) // "attendance", "activity", "tool", etc
  title           String           @db.VarChar(200)
  message         String           @db.Text
  triggerUserId   Int? // Usuario que desencadenó la notificación
  relatedEntityId Int?
  entityType      String?          @db.VarChar(50) // "activity", "evidence", "tool_request", etc
  relatedUrl      String?          @db.VarChar(500)
  priority        String?          @default("normal") @db.VarChar(20) // "high", "normal", "low"
  isRead          Boolean          @default(false)
  readAt          DateTime?
  companyId       Int?
  createdAt       DateTime         @default(now())

  // Relaciones
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerUser User?           @relation("NotificationTriggeredBy", fields: [triggerUserId], references: [id], onDelete: SetNull)
  company     CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([userId, category])
  @@index([isRead, createdAt])
  @@index([companyId])
  @@map("notifications")
}

model Fine {
  id                Int            @id @default(autoincrement())
  usuarioId         Int
  tipo              String         @db.VarChar(50) // "actividad", "vehiculo", "asistencia", "herramienta"
  razon             String         @db.VarChar(100)
  descripcion       String?        @db.Text
  monto             Decimal        @db.Decimal(10, 2)
  referenciaId      Int? // id de la actividad, vehiculo, etc.
  estatusPago       String         @default("Pendiente") @db.VarChar(30)
  estatusAprobacion String         @default("Pendiente") @db.VarChar(30)
  approvalStep      Int            @default(0)
  approvalTrail     Json?
  fechaCreacion     DateTime       @default(now())
  fechaPago         DateTime?
  notas             String?
  companyId         Int
  usuario           User           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  company           CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([usuarioId, tipo, estatusPago])
  @@index([companyId])
  @@map("fines")
}

enum ToolRequestStatus {
  PENDING // Solicitud pendiente de aprobación
  APPROVED // Aprobada por admin
  IN_USE // Herramienta en uso por el usuario
  RETURNED // Devuelta
  DAMAGED // Devuelta con daños
  REJECTED // Solicitud rechazada
}

enum RenewalStatus {
  PENDING // Solicitud de renovación pendiente
  APPROVED // Renovación aprobada
  REJECTED // Renovación rechazada
}

enum ToolInventoryStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
}

enum ToolAssignmentType {
  KIT
  LOAN
}

enum ToolKitEventResolution {
  PENDING
  USER_MISUSE
  EQUIPMENT_FAILURE
}

model ToolRequest {
  id                     Int               @id @default(autoincrement())
  usuarioId              Int
  inventoryItemId        Int?
  toolName               String            @db.VarChar(200) // Nombre de la herramienta
  model                  String            @db.VarChar(200) // Modelo
  serialNumber           String            @db.VarChar(200) // Número de serie
  reason                 String            @db.Text // Motivo de uso
  startDate              DateTime // Fecha de inicio del préstamo
  expectedReturnDate     DateTime // Fecha esperada de devolución (candlerizacion)
  generalPhotoUrl        String            @db.VarChar(500) // Foto panorámica
  specificationsPhotoUrl String            @db.VarChar(500) // Foto de modelo y serie
  status                 ToolRequestStatus @default(PENDING)
  requestDate            DateTime          @default(now()) // Fecha de solicitud
  approvalDate           DateTime? // Fecha de aprobación
  deliveryDate           DateTime? // Fecha de entrega al usuario
  returnDate             DateTime? // Fecha de devolución real
  damageDescription      String?           @db.Text // Descripción de daños si aplica
  damagePhotoUrl         String?           @db.VarChar(500) // Foto de daños si aplica
  adminNotes             String?           @db.Text // Notas del administrador
  approvedBy             Int? // Usuario admin que aprobó
  notificationSent       Boolean           @default(false) // Notificación de vencimiento enviada
  notificationSentAt     DateTime? // Fecha de envío de notificación
  renewalCount           Int               @default(0) // Contador de renovaciones
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  usuario       User                      @relation("UserToolRequests", fields: [usuarioId], references: [id], onDelete: Cascade)
  inventoryItem ToolInventoryItem?        @relation("ToolInventoryToolRequests", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  approver      User?                     @relation("AdminApprovals", fields: [approvedBy], references: [id])
  renewals      ToolRenewal[]             @relation("ToolRequestRenewals")
  notifications ToolRequestNotification[] @relation("ToolRequestNotifications")
  companyId     Int
  company       CompanyProfile            @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([usuarioId, status])
  @@index([inventoryItemId])
  @@index([status, requestDate])
  @@index([expectedReturnDate])
  @@index([companyId])
  @@map("tool_requests")
}

model ToolInventoryItem {
  id                Int                 @id @default(autoincrement())
  toolName          String              @db.VarChar(200)
  model             String              @db.VarChar(200)
  serialNumber      String              @db.VarChar(200)
  panoramicPhotoUrl String              @db.VarChar(500)
  serialPhotoUrl    String              @db.VarChar(500)
  status            ToolInventoryStatus @default(AVAILABLE)
  createdById       Int?
  updatedById       Int?
  replacementOfId   Int?
  retiredReason     String?             @db.Text
  companyId         Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  createdBy         User?               @relation("ToolInventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?               @relation("ToolInventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  replacementOf     ToolInventoryItem?  @relation("ToolInventoryReplacements", fields: [replacementOfId], references: [id], onDelete: SetNull)
  replacements      ToolInventoryItem[] @relation("ToolInventoryReplacements")
  kitAssignments    ToolKitAssignment[] @relation("ToolInventoryAssignments")
  toolRequests      ToolRequest[]       @relation("ToolInventoryToolRequests")
  replacementEvents ToolKitEvent[]      @relation("ToolKitEventReplacementItem")
  company           CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, serialNumber])
  @@index([status])
  @@index([toolName, model])
  @@index([replacementOfId])
  @@index([companyId])
  @@map("tool_inventory_items")
}

model ToolKitAssignment {
  id               Int                @id @default(autoincrement())
  inventoryItemId  Int
  userId           Int
  assignmentType   ToolAssignmentType @default(KIT)
  assignedById     Int?
  assignedAt       DateTime           @default(now())
  dueReturnDate    DateTime?
  returnedAt       DateTime?
  isActive         Boolean            @default(true)
  replacementCount Int                @default(0)
  notes            String?            @db.Text
  companyId        Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  inventoryItem ToolInventoryItem @relation("ToolInventoryAssignments", fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User              @relation("ToolKitUserAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy    User?             @relation("ToolKitAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  company       CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  events        ToolKitEvent[]    @relation("ToolKitAssignmentEvents")

  @@index([userId, isActive])
  @@index([inventoryItemId, isActive])
  @@index([companyId])
  @@map("tool_kit_assignments")
}

model ToolKitEvent {
  id                Int                    @id @default(autoincrement())
  assignmentId      Int
  reportedById      Int
  resolvedById      Int?
  fineId            Int?
  replacementItemId Int?
  description       String                 @db.Text
  resolution        ToolKitEventResolution @default(PENDING)
  reportedAt        DateTime               @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime               @default(now())

  assignment      ToolKitAssignment  @relation("ToolKitAssignmentEvents", fields: [assignmentId], references: [id], onDelete: Cascade)
  reportedBy      User               @relation("ToolKitEventReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  resolvedBy      User?              @relation("ToolKitEventResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  replacementItem ToolInventoryItem? @relation("ToolKitEventReplacementItem", fields: [replacementItemId], references: [id], onDelete: SetNull)

  @@index([assignmentId, reportedAt])
  @@index([resolution])
  @@map("tool_kit_events")
}

model ToolRenewal {
  id                 Int           @id @default(autoincrement())
  toolRequestId      Int
  previousReturnDate DateTime // Fecha de devolución anterior
  newReturnDate      DateTime // Nueva fecha de devolución
  renewalReason      String?       @db.Text // Razón de la renovación
  approvedBy         Int? // Usuario admin que aprobó
  requestDate        DateTime      @default(now()) // Fecha de solicitud de renovación
  approvalDate       DateTime? // Fecha de aprobación
  status             RenewalStatus @default(PENDING)
  companyId          Int
  createdAt          DateTime      @default(now())

  toolRequest ToolRequest    @relation("ToolRequestRenewals", fields: [toolRequestId], references: [id], onDelete: Cascade)
  approver    User?          @relation("AdminRenewals", fields: [approvedBy], references: [id])
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([toolRequestId, status])
  @@index([approvalDate])
  @@index([companyId])
  @@map("tool_renewals")
}

model ToolRequestNotification {
  id            Int              @id @default(autoincrement())
  toolRequestId Int
  usuarioId     Int
  type          NotificationType
  message       String           @db.Text
  isRead        Boolean          @default(false)
  readAt        DateTime?
  sentAt        DateTime         @default(now())

  toolRequest ToolRequest @relation("ToolRequestNotifications", fields: [toolRequestId], references: [id], onDelete: Cascade)
  usuario     User        @relation("ToolNotifications", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, isRead])
  @@index([toolRequestId, type])
  @@map("tool_request_notifications")
}

// ============================================================================
// ERP INDUSTRIAL - CONTABILIDAD (Accounting / General Ledger)
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum InvoiceStatus {
  DRAFT
  STAMPING
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  CREDITED
}

enum InvoiceType {
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
}

// 3-way match PO-GR-factura AP
enum InvoiceMatchStatus {
  NOT_REQUIRED
  PENDING
  MATCHED
  VARIANCE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CREDIT_CARD
  SPEI
  DOMICILIACION
  CARD_DEBIT
  DIGITAL_WALLET
  COMPENSATION
  OTHER
}

// SAT: Uso de CFDI (catálogo c_UsoCFDI)
enum CfdiUsage {
  G01 // Adquisición de mercancías
  G02 // Devoluciones, descuentos o bonificaciones
  G03 // Gastos en general
  I01 // Construcciones
  I02 // Mobiliario y equipo de oficina
  I03 // Equipo de transporte
  I04 // Equipo de cómputo
  I05 // Dados, troqueles, moldes, matrices
  I06 // Comunicaciones telefónicas
  I07 // Comunicaciones satelitales
  I08 // Otra maquinaria y equipo
  D01 // Honorarios médicos
  D02 // Gastos médicos por incapacidad
  D03 // Gastos funerales
  D04 // Donativos
  D05 // Intereses de créditos hipotecarios
  D06 // Aportaciones voluntarias al SAR
  D07 // Primas de seguros
  D08 // Gastos de transportación escolar
  D10 // Pagos por servicios educativos
  P01 // Por definir
  S01 // Sin efectos fiscales
  CP01 // Pagos
}

// SAT: Régimen fiscal (catálogo c_RegimenFiscal)
enum FiscalRegime {
  R601 // General de Ley Personas Morales
  R603 // Personas Morales con Fines no Lucrativos
  R605 // Sueldos y Salarios
  R606 // Arrendamiento
  R607 // Régimen de Enajenación o Adquisición de Bienes
  R608 // Demás ingresos
  R610 // Residentes en el Extranjero sin EP
  R611 // Ingresos por Dividendos
  R612 // Personas Físicas con Actividades Empresariales y Profesionales
  R614 // Ingresos por intereses
  R615 // Régimen de los ingresos por obtención de premios
  R616 // Sin obligaciones fiscales
  R620 // Sociedades Cooperativas de Producción
  R621 // Incorporación Fiscal
  R622 // Actividades Agrícolas, Ganaderas, Silvícolas y Pesqueras
  R623 // Opcional para Grupos de Sociedades
  R624 // Coordinados
  R625 // RESICO Personas Físicas
  R626 // RESICO Personas Morales
}

// SAT: Forma de pago (catálogo c_FormaPago)
enum SatPaymentForm {
  FP01 // Efectivo
  FP02 // Cheque nominativo
  FP03 // Transferencia electrónica de fondos (SPEI)
  FP04 // Tarjeta de crédito
  FP05 // Monedero electrónico
  FP06 // Dinero electrónico
  FP08 // Vales de despensa
  FP12 // Dación en pago
  FP13 // Pago por subrogación
  FP14 // Pago por consignación
  FP15 // Condonación
  FP17 // Compensación
  FP23 // Novación
  FP24 // Confusión
  FP25 // Remisión de deuda
  FP26 // Prescripción o caducidad
  FP27 // A satisfacción del acreedor
  FP28 // Tarjeta de débito
  FP29 // Tarjeta de servicios
  FP30 // Aplicación de anticipos
  FP31 // Intermediario pagos
  FP99 // Por definir
}

// SAT: Método de pago
enum SatPaymentMethod {
  PUE // Pago en una sola exhibición
  PPD // Pago en parcialidades o diferido
}

enum BankReconciliationStatus {
  PENDING
  MATCHED
  UNMATCHED
  ADJUSTED
}

model Account {
  id                 Int                @id @default(autoincrement())
  code               String             @db.VarChar(30)
  name               String             @db.VarChar(200)
  type               AccountType
  parentId           Int?
  description        String?
  isActive           Boolean            @default(true)
  currency           String             @default("MXN") @db.VarChar(10)
  balance            Decimal            @default(0) @db.Decimal(16, 2)
  /// Código de agrupador del catálogo SAT (Contabilidad Electrónica).
  /// Nullable: requiere mapeo contable explícito por cuenta antes de exportar XML.
  satAgrupador       String?            @db.VarChar(20)
  companyId          Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  parent             Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children           Account[]          @relation("AccountHierarchy")
  company            CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  debitEntries       JournalEntryLine[] @relation("DebitAccount")
  creditEntries      JournalEntryLine[] @relation("CreditAccount")
  costCenterDefaults CostCenter[]       @relation("CostCenterDefaultAccount")

  @@unique([companyId, code])
  @@index([type])
  @@index([parentId])
  @@index([companyId])
  @@map("accounts")
}

model FiscalPeriod {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(60)
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  isClosed       Boolean        @default(false)
  closedAt       DateTime?
  closedById     Int?
  companyId      Int
  createdAt      DateTime       @default(now())
  closedBy       User?          @relation("FiscalPeriodClosedBy", fields: [closedById], references: [id])
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([companyId, startDate, endDate])
  @@index([companyId])
  @@map("fiscal_periods")
}

model JournalEntry {
  id               Int                @id @default(autoincrement())
  entryNumber      String             @db.VarChar(30)
  date             DateTime           @db.Date
  description      String
  reference        String?            @db.VarChar(100)
  status           JournalEntryStatus @default(DRAFT)
  fiscalPeriodId   Int?
  reversalOfId     Int?               @unique
  totalDebit       Decimal            @default(0) @db.Decimal(16, 2)
  totalCredit      Decimal            @default(0) @db.Decimal(16, 2)
  createdById      Int?
  postedAt         DateTime?
  companyId        Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  fiscalPeriod     FiscalPeriod?      @relation(fields: [fiscalPeriodId], references: [id])
  reversalOf       JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy       JournalEntry?      @relation("JournalReversal")
  createdBy        User?              @relation("JournalEntryCreator", fields: [createdById], references: [id])
  company          CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines            JournalEntryLine[]
  expenses         Expense[]
  viaticos         Viatico[]
  employeePayments EmployeePayment[]
  goodsReceipts    GoodsReceipt[]

  @@unique([companyId, entryNumber])
  @@unique([companyId, reference])
  @@index([date])
  @@index([status])
  @@index([companyId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              Int          @id @default(autoincrement())
  journalEntryId  Int
  debitAccountId  Int
  creditAccountId Int?
  description     String?      @db.VarChar(300)
  debit           Decimal      @default(0) @db.Decimal(16, 2)
  credit          Decimal      @default(0) @db.Decimal(16, 2)
  costCenterId    Int?
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  debitAccount    Account      @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount   Account?     @relation("CreditAccount", fields: [creditAccountId], references: [id])
  costCenter      CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@index([journalEntryId])
  @@index([debitAccountId])
  @@map("journal_entry_lines")
}

model CostCenter {
  id               Int                @id @default(autoincrement())
  code             String             @db.VarChar(30)
  name             String             @db.VarChar(200)
  departmentId     Int?
  defaultAccountId Int?
  companyId        Int
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  department       Department?        @relation(fields: [departmentId], references: [id])
  defaultAccount   Account?           @relation("CostCenterDefaultAccount", fields: [defaultAccountId], references: [id])
  company          CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journalLines     JournalEntryLine[]
  budgets          Budget[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_centers")
}

model Invoice {
  id                  Int                @id @default(autoincrement())
  invoiceNumber       String             @db.VarChar(40)
  type                InvoiceType
  status              InvoiceStatus      @default(DRAFT)
  issueDate           DateTime           @db.Date
  dueDate             DateTime           @db.Date
  clientId            Int?
  supplierId          Int?
  subtotal            Decimal            @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal            @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal            @default(0) @db.Decimal(14, 2)
  paidAmount          Decimal            @default(0) @db.Decimal(14, 2)
  currency            String             @default("MXN") @db.VarChar(10)
  notes               String?
  // ── CFDI 4.0 / SAT fields ──
  cfdiUuid            String?            @db.VarChar(80)
  cfdiXml             String?
  pdfUrl              String?            @db.VarChar(500)
  cfdiVersion         String?            @default("4.0") @db.VarChar(5)
  cfdiSerie           String?            @db.VarChar(25)
  cfdiFolio           String?            @db.VarChar(40)
  cfdiUsage           CfdiUsage?         @default(G03)
  satPaymentForm      SatPaymentForm?    @default(FP99)
  satPaymentMethod    SatPaymentMethod?  @default(PUE)
  emisorRfc           String?            @db.VarChar(13)
  emisorName          String?            @db.VarChar(300)
  emisorRegime        FiscalRegime?      @default(R601)
  receptorRfc         String?            @db.VarChar(13)
  receptorName        String?            @db.VarChar(300)
  receptorRegime      FiscalRegime?
  receptorZipCode     String?            @db.VarChar(5)
  exchangeRate        Decimal?           @db.Decimal(10, 4)
  cfdiStampDate       DateTime?
  satCertNumber       String?            @db.VarChar(30)
  cfdiRelationType    String?            @db.VarChar(5)
  cfdiRelatedUuids    String? // Comma-separated UUIDs of related CFDI
  isCancelled         Boolean            @default(false)
  cancelledAt         DateTime?
  cancelReason        String?            @db.VarChar(5)
  substitutionUuid    String?            @db.VarChar(80)
  // ── end CFDI ──
  createdById         Int?
  companyId           Int
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  client              SalesClient?       @relation(fields: [clientId], references: [id])
  supplier            Supplier?          @relation("SupplierInvoices", fields: [supplierId], references: [id])
  createdBy           User?              @relation("InvoiceCreator", fields: [createdById], references: [id])
  company             CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items               InvoiceItem[]
  payments            Payment[]
  /// Servicio facturado. Permite responder "¿qué trabajo cerrado sigue sin
  /// facturar?", que antes no tenía camino de datos.
  activityId          Int?
  activity            Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  salesProjectOrderId Int?
  salesProjectOrder   SalesProjectOrder? @relation(fields: [salesProjectOrderId], references: [id], onDelete: SetNull)
  purchaseOrderId     Int?
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId      Int?
  goodsReceipt        GoodsReceipt?      @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  matchStatus         InvoiceMatchStatus @default(NOT_REQUIRED)
  matchedAt           DateTime?
  matchedById         Int?
  matchNotes          String?            @db.VarChar(500)
  matchedBy           User?              @relation("InvoiceMatcher", fields: [matchedById], references: [id])

  @@unique([cfdiUuid])
  @@unique([companyId, invoiceNumber])
  @@index([type, status])
  @@index([dueDate])
  @@index([emisorRfc])
  @@index([receptorRfc])
  @@index([companyId])
  @@index([matchStatus])
  @@map("invoices")
}

model InvoiceItem {
  id                  Int                    @id @default(autoincrement())
  invoiceId           Int
  description         String                 @db.VarChar(300)
  quantity            Decimal                @db.Decimal(12, 4)
  unitPrice           Decimal                @db.Decimal(14, 2)
  taxRate             Decimal                @default(0) @db.Decimal(5, 2)
  total               Decimal                @db.Decimal(14, 2)
  productId           Int?
  // ── SAT catalog fields ──
  satProductKey       String?                @db.VarChar(10) // ClaveProdServ (catálogo SAT)
  satUnitKey          String?                @db.VarChar(5) // ClaveUnidad (catálogo SAT)
  unitName            String?                @db.VarChar(50) // e.g. "Pieza", "Servicio"
  discount            Decimal                @default(0) @db.Decimal(14, 2)
  taxBase             Decimal?               @db.Decimal(14, 2)
  ivaRate             Decimal?               @db.Decimal(5, 2) // IVA 16%, 8%, 0%
  ivaAmount           Decimal?               @db.Decimal(14, 2)
  iepsRate            Decimal?               @db.Decimal(5, 2)
  iepsAmount          Decimal?               @db.Decimal(14, 2)
  isrRetRate          Decimal?               @db.Decimal(5, 2)
  isrRetAmount        Decimal?               @db.Decimal(14, 2)
  ivaRetRate          Decimal?               @db.Decimal(5, 4)
  ivaRetAmount        Decimal?               @db.Decimal(14, 2)
  // ── end SAT ──
  purchaseOrderItemId Int?
  goodsReceiptItemId  Int?
  invoice             Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product?               @relation(fields: [productId], references: [id])
  salesOrderLineId    Int?                   @unique
  salesOrderLine      SalesProjectOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  purchaseOrderItem   PurchaseOrderItem?     @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  goodsReceiptItem    GoodsReceiptItem?      @relation(fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderItemId])
  @@index([goodsReceiptItemId])
  @@map("invoice_items")
}

model Payment {
  id              Int             @id @default(autoincrement())
  invoiceId       Int
  amount          Decimal         @db.Decimal(14, 2)
  paymentDate     DateTime        @db.Date
  method          PaymentMethod   @default(SPEI)
  reference       String?         @db.VarChar(100)
  bankAccountId   Int?
  notes           String?
  // ── MX payment fields ──
  satPaymentForm  SatPaymentForm? @default(FP03) // SPEI por defecto
  speiTrackingKey String?         @db.VarChar(30)
  exchangeRate    Decimal?        @db.Decimal(10, 4)
  operationNumber String?         @db.VarChar(50)
  cfdiPaymentUuid String?         @db.VarChar(80) // UUID del complemento de pago
  // ── end MX ──
  createdById     Int?
  companyId       Int
  createdAt       DateTime        @default(now())
  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount?    @relation(fields: [bankAccountId], references: [id])
  createdBy       User?           @relation("PaymentCreator", fields: [createdById], references: [id])
  company         CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([cfdiPaymentUuid])
  @@unique([companyId, speiTrackingKey])
  @@index([invoiceId])
  @@index([companyId])
  @@map("payments")
}

model BankAccount {
  id              Int                  @id @default(autoincrement())
  name            String               @db.VarChar(200)
  bankName        String               @db.VarChar(200)
  accountNumber   String               @db.VarChar(40)
  clabe           String?              @db.VarChar(20)
  currency        String               @default("MXN") @db.VarChar(10)
  currentBalance  Decimal              @default(0) @db.Decimal(16, 2)
  isActive        Boolean              @default(true)
  // ── Banorte / MX banking fields ──
  bankCode        String?              @db.VarChar(10) // Clave bancaria (e.g. "072" = Banorte)
  rfc             String?              @db.VarChar(13)
  accountType     String?              @db.VarChar(30) // "CHEQUES", "INVERSION", "NOMINA"
  branch          String?              @db.VarChar(10)
  lastSyncAt      DateTime?
  speiEnabled     Boolean              @default(true)
  cepUrl          String?              @db.VarChar(500) // URL para Comprobante Electrónico de Pago
  companyId       Int
  // ── end banking ──
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  company         CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payments        Payment[]
  reconciliations BankReconciliation[]
  transactions    BankTransaction[]

  @@index([companyId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                Int                 @id @default(autoincrement())
  bankAccountId     Int
  transactionDate   DateTime            @db.Date
  description       String              @db.VarChar(500)
  amount            Decimal             @db.Decimal(14, 2)
  isDebit           Boolean
  externalRef       String?             @db.VarChar(100)
  // ── MX SPEI fields ──
  speiTrackingKey   String?             @db.VarChar(30) // Clave de rastreo SPEI
  speiCep           String? // CEP XML content
  counterpartyRfc   String?             @db.VarChar(13)
  counterpartyName  String?             @db.VarChar(300)
  counterpartyClabe String?             @db.VarChar(20)
  counterpartyBank  String?             @db.VarChar(100)
  concept           String?             @db.VarChar(200)
  beneficiaryRef    String?             @db.VarChar(7) // Referencia numérica Banorte
  // ── end SPEI ──
  importedAt        DateTime            @default(now())
  companyId         Int
  bankAccount       BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciliation    BankReconciliation?
  company           CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([bankAccountId, speiTrackingKey])
  @@index([bankAccountId, transactionDate])
  @@index([companyId])
  @@map("bank_transactions")
}

model BankReconciliation {
  id                Int                      @id @default(autoincrement())
  bankAccountId     Int
  bankTransactionId Int                      @unique
  status            BankReconciliationStatus @default(PENDING)
  matchedAmount     Decimal?                 @db.Decimal(14, 2)
  notes             String?
  reconciledAt      DateTime?
  reconciledById    Int?
  createdAt         DateTime                 @default(now())
  companyId         Int
  bankAccount       BankAccount              @relation(fields: [bankAccountId], references: [id])
  bankTransaction   BankTransaction          @relation(fields: [bankTransactionId], references: [id])
  reconciledBy      User?                    @relation("ReconciliationUser", fields: [reconciledById], references: [id])
  company           CompanyProfile           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([bankAccountId, status])
  @@index([companyId])
  @@map("bank_reconciliations")
}

model Budget {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(200)
  costCenterId  Int
  year          Int
  month         Int?
  plannedAmount Decimal        @db.Decimal(14, 2)
  actualAmount  Decimal        @default(0) @db.Decimal(14, 2)
  notes         String?
  companyId     Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  costCenter    CostCenter     @relation(fields: [costCenterId], references: [id])
  company       CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, costCenterId, year, month])
  @@index([companyId])
  @@map("budgets")
}

// ============================================================================
// ERP INDUSTRIAL - INVENTARIO AVANZADO (Advanced Warehouse Inventory)
// ============================================================================

enum StockMovementType {
  RECEIPT
  DISPATCH
  TRANSFER
  ADJUSTMENT
  RETURN
  SCRAP
  PRODUCTION_IN
  PRODUCTION_OUT
}

enum ValuationMethod {
  FIFO
  LIFO
  WEIGHTED_AVERAGE
}

model Warehouse {
  id                Int                 @id @default(autoincrement())
  code              String              @db.VarChar(20)
  name              String              @db.VarChar(200)
  address           String?
  city              String?             @db.VarChar(120)
  state             String?             @db.VarChar(120)
  managerId         Int?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  manager           User?               @relation("WarehouseManager", fields: [managerId], references: [id])
  locations         WarehouseLocation[]
  stockLevels       StockLevel[]
  movementsFrom     StockMovement[]     @relation("MovementFromWarehouse")
  movementsTo       StockMovement[]     @relation("MovementToWarehouse")
  goodsReceipts     GoodsReceipt[]
  cycleCounts       CycleCount[]
  stockReservations StockReservation[]
  companyId         Int
  company           CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model WarehouseLocation {
  id          Int            @id @default(autoincrement())
  warehouseId Int
  code        String         @db.VarChar(30)
  name        String         @db.VarChar(120)
  aisle       String?        @db.VarChar(20)
  rack        String?        @db.VarChar(20)
  shelf       String?        @db.VarChar(20)
  bin         String?        @db.VarChar(20)
  createdAt   DateTime       @default(now())
  companyId   Int
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, code])
  @@index([companyId])
  @@map("warehouse_locations")
}

model StockLevel {
  id              Int                @id @default(autoincrement())
  productId       Int
  warehouseId     Int
  locationId      Int?
  quantity        Decimal            @default(0) @db.Decimal(14, 4)
  reservedQty     Decimal            @default(0) @db.Decimal(14, 4)
  reorderPoint    Decimal            @default(0) @db.Decimal(14, 4)
  minStock        Decimal            @default(0) @db.Decimal(14, 4)
  maxStock        Decimal            @default(0) @db.Decimal(14, 4)
  unitCost        Decimal            @default(0) @db.Decimal(14, 4)
  valuationMethod ValuationMethod    @default(WEIGHTED_AVERAGE)
  lastCountDate   DateTime?
  updatedAt       DateTime           @updatedAt
  companyId       Int
  product         Product            @relation(fields: [productId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])
  lotStocks       LotStock[]
  company         CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId, locationId])
  @@index([warehouseId])
  @@index([companyId])
  @@map("stock_levels")
}

model StockMovement {
  id                Int               @id @default(autoincrement())
  movementNumber    String            @db.VarChar(30)
  type              StockMovementType
  productId         Int
  fromWarehouseId   Int?
  toWarehouseId     Int?
  quantity          Decimal           @db.Decimal(14, 4)
  unitCost          Decimal           @default(0) @db.Decimal(14, 4)
  totalCost         Decimal           @default(0) @db.Decimal(14, 2)
  lotId             Int?
  reference         String?           @db.VarChar(200)
  notes             String?
  purchaseOrderId   Int?
  productionOrderId Int?
  createdById       Int?
  companyId         Int
  createdAt         DateTime          @default(now())
  product           Product           @relation(fields: [productId], references: [id])
  fromWarehouse     Warehouse?        @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse       Warehouse?        @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])
  lot               Lot?              @relation(fields: [lotId], references: [id])
  purchaseOrder     PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id])
  /// Servicio que consumió el material. Sin esto no se podía responder
  /// "¿qué material usó esta actividad?", que es el control de materiales de
  /// Operaciones y el "Material utilizado" que reporta Ingeniería.
  activityId        Int?
  activity          Activity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  createdBy         User?             @relation("StockMovementCreator", fields: [createdById], references: [id])
  company           CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, movementNumber])
  @@index([productId, type])
  @@index([createdAt])
  @@index([companyId])
  @@map("stock_movements")
}

model Lot {
  id                 Int                 @id @default(autoincrement())
  lotNumber          String              @db.VarChar(60)
  productId          Int
  expirationDate     DateTime?
  manufacturingDate  DateTime?
  supplierId         Int?
  notes              String?
  companyId          Int
  createdAt          DateTime            @default(now())
  product            Product             @relation(fields: [productId], references: [id])
  supplier           Supplier?           @relation("LotSupplier", fields: [supplierId], references: [id])
  company            CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  movements          StockMovement[]
  lotStocks          LotStock[]
  qualityInspections QualityInspection[]

  @@unique([companyId, lotNumber])
  @@index([productId])
  @@index([companyId])
  @@map("lots")
}

model LotStock {
  id           Int        @id @default(autoincrement())
  lotId        Int
  stockLevelId Int
  quantity     Decimal    @db.Decimal(14, 4)
  lot          Lot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  stockLevel   StockLevel @relation(fields: [stockLevelId], references: [id], onDelete: Cascade)

  @@unique([lotId, stockLevelId])
  @@map("lot_stocks")
}

enum CycleCountStatus {
  SCHEDULED
  IN_PROGRESS
  CLOSED
  CANCELLED
}

/// Conteo físico programado de un subconjunto de SKUs en un almacén.
/// Al cerrar, la varianza por producto genera un StockMovement ADJUSTMENT
/// (reutiliza la misma ruta de ajuste de stock que ya existe, no duplica lógica de WAC).
model CycleCount {
  id           Int              @id @default(autoincrement())
  countNumber  String           @db.VarChar(30)
  warehouseId  Int
  status       CycleCountStatus @default(SCHEDULED)
  scheduledFor DateTime         @db.Date
  closedAt     DateTime?
  notes        String?
  companyId    Int
  createdById  Int?
  closedById   Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  company      CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("CycleCountCreator", fields: [createdById], references: [id])
  closedBy     User?            @relation("CycleCountCloser", fields: [closedById], references: [id])
  items        CycleCountItem[]

  @@unique([companyId, countNumber])
  @@index([warehouseId])
  @@index([companyId])
  @@index([status])
  @@map("cycle_counts")
}

model CycleCountItem {
  id           Int        @id @default(autoincrement())
  cycleCountId Int
  productId    Int
  expectedQty  Decimal    @db.Decimal(14, 4)
  countedQty   Decimal?   @db.Decimal(14, 4)
  varianceQty  Decimal?   @db.Decimal(14, 4)
  countedAt    DateTime?
  notes        String?
  cycleCount   CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@unique([cycleCountId, productId])
  @@index([cycleCountId])
  @@map("cycle_count_items")
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

/// Reserva "soft" de stock: reduce lo disponible (quantity - reservedQty en
/// StockLevel) sin mover físico. El agregado de reservas activas de un
/// producto/almacén se refleja en StockLevel.reservedQty.
model StockReservation {
  id            Int                    @id @default(autoincrement())
  productId     Int
  warehouseId   Int
  quantity      Decimal                @db.Decimal(14, 4)
  status        StockReservationStatus @default(ACTIVE)
  reason        String                 @db.VarChar(200)
  referenceType String?                @db.VarChar(60)
  referenceId   Int?
  expiresAt     DateTime?
  releasedAt    DateTime?
  companyId     Int
  createdById   Int?
  createdAt     DateTime               @default(now())
  product       Product                @relation(fields: [productId], references: [id])
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  company       CompanyProfile         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy     User?                  @relation("StockReservationCreator", fields: [createdById], references: [id])

  @@index([productId, warehouseId])
  @@index([companyId])
  @@index([status])
  @@map("stock_reservations")
}

// ============================================================================
// ERP INDUSTRIAL - COMPRAS (Procurement)
// ============================================================================

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  INVOICED
  CANCELLED
}

model PurchaseRequisition {
  id              Int                       @id @default(autoincrement())
  reqNumber       String                    @db.VarChar(30)
  title           String                    @db.VarChar(200)
  description     String?
  status          PurchaseRequisitionStatus @default(DRAFT)
  priority        String                    @default("NORMAL") @db.VarChar(20)
  requiredDate    DateTime?                 @db.Date
  departmentId    Int?
  requestedById   Int
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?
  companyId       Int
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  department      Department?               @relation(fields: [departmentId], references: [id])
  requestedBy     User                      @relation("RequisitionRequester", fields: [requestedById], references: [id])
  approvedBy      User?                     @relation("RequisitionApprover", fields: [approvedById], references: [id])
  company         CompanyProfile            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items           PurchaseRequisitionItem[]
  purchaseOrders  PurchaseOrder[]
  rfqs            PurchaseRFQ[]

  @@unique([companyId, reqNumber])
  @@index([status])
  @@index([companyId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id            Int                 @id @default(autoincrement())
  requisitionId Int
  productId     Int?
  description   String              @db.VarChar(300)
  quantity      Decimal             @db.Decimal(14, 4)
  estimatedCost Decimal?            @db.Decimal(14, 2)
  notes         String?
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product       Product?            @relation(fields: [productId], references: [id])

  @@map("purchase_requisition_items")
}

model PurchaseOrder {
  id              Int                  @id @default(autoincrement())
  poNumber        String               @db.VarChar(30)
  status          PurchaseOrderStatus  @default(DRAFT)
  supplierId      Int
  requisitionId   Int?
  orderDate       DateTime             @db.Date
  expectedDate    DateTime?            @db.Date
  subtotal        Decimal              @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal              @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal              @default(0) @db.Decimal(14, 2)
  currency        String               @default("MXN") @db.VarChar(10)
  paymentTerms    String?              @db.VarChar(200)
  shippingAddress String?
  notes           String?
  createdById     Int?
  approvedById    Int?
  approvedAt      DateTime?
  companyId       Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  supplier        Supplier             @relation("SupplierPurchaseOrders", fields: [supplierId], references: [id])
  requisition     PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  createdBy       User?                @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  approvedBy      User?                @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  company         CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]
  receipts        GoodsReceipt[]
  stockMovements  StockMovement[]
  invoices        Invoice[]
  awardedRfq      PurchaseRFQ?

  @@unique([companyId, poNumber])
  @@index([supplierId, status])
  @@index([companyId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int                @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int?
  description     String             @db.VarChar(300)
  quantity        Decimal            @db.Decimal(14, 4)
  receivedQty     Decimal            @default(0) @db.Decimal(14, 4)
  unitPrice       Decimal            @db.Decimal(14, 2)
  taxRate         Decimal            @default(0) @db.Decimal(5, 2)
  total           Decimal            @db.Decimal(14, 2)
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?           @relation(fields: [productId], references: [id])
  receiptItems    GoodsReceiptItem[]
  invoiceItems    InvoiceItem[]

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              Int                @id @default(autoincrement())
  receiptNumber   String             @db.VarChar(30)
  purchaseOrderId Int
  warehouseId     Int?
  receiptDate     DateTime           @db.Date
  notes           String?
  receivedById    Int?
  journalEntryId  Int?
  /// Landed cost: cargos adicionales prorrateados sobre el costo unitario recibido.
  freightCost     Decimal            @default(0) @db.Decimal(14, 2)
  insuranceCost   Decimal            @default(0) @db.Decimal(14, 2)
  customsCost     Decimal            @default(0) @db.Decimal(14, 2)
  otherLandedCost Decimal            @default(0) @db.Decimal(14, 2)
  companyId       Int
  createdAt       DateTime           @default(now())
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse       Warehouse?         @relation(fields: [warehouseId], references: [id])
  receivedBy      User?              @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id])
  journalEntry    JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  company         CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]
  invoices        Invoice[]

  @@unique([companyId, receiptNumber])
  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([companyId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  Int               @id @default(autoincrement())
  goodsReceiptId      Int
  purchaseOrderItemId Int
  quantityReceived    Decimal           @db.Decimal(14, 4)
  quantityRejected    Decimal           @default(0) @db.Decimal(14, 4)
  lotNumber           String?           @db.VarChar(60)
  notes               String?
  /// Porción del landed cost de la recepción prorrateada a esta línea (por valor).
  landedCostAllocated Decimal           @default(0) @db.Decimal(14, 4)
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  invoiceItems        InvoiceItem[]

  @@map("goods_receipt_items")
}

model SupplierEvaluation {
  id             Int            @id @default(autoincrement())
  supplierId     Int
  evaluationDate DateTime       @db.Date
  qualityScore   Int            @default(0)
  deliveryScore  Int            @default(0)
  priceScore     Int            @default(0)
  serviceScore   Int            @default(0)
  overallScore   Decimal        @default(0) @db.Decimal(5, 2)
  notes          String?
  evaluatedById  Int?
  companyId      Int
  createdAt      DateTime       @default(now())
  supplier       Supplier       @relation("SupplierEvaluations", fields: [supplierId], references: [id])
  evaluatedBy    User?          @relation("SupplierEvaluator", fields: [evaluatedById], references: [id])
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([companyId])
  @@map("supplier_evaluations")
}

enum PurchaseRFQStatus {
  DRAFT
  SENT
  QUOTED
  AWARDED
  CANCELLED
}

/// Solicitud de cotización a N proveedores para una requisición. Adjudicar
/// genera la PurchaseOrder existente (no duplica el flujo OC→GR→stock→AP).
model PurchaseRFQ {
  id                     Int                 @id @default(autoincrement())
  rfqNumber              String              @db.VarChar(30)
  requisitionId          Int
  status                 PurchaseRFQStatus   @default(DRAFT)
  dueDate                DateTime?           @db.Date
  notes                  String?
  companyId              Int
  createdById            Int?
  awardedPurchaseOrderId Int?                @unique
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  requisition            PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  company                CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy              User?               @relation("PurchaseRFQCreator", fields: [createdById], references: [id])
  awardedPurchaseOrder   PurchaseOrder?      @relation(fields: [awardedPurchaseOrderId], references: [id])
  lines                  PurchaseRFQLine[]

  @@unique([companyId, rfqNumber])
  @@index([requisitionId])
  @@index([companyId])
  @@map("purchase_rfqs")
}

model PurchaseRFQLine {
  id           Int         @id @default(autoincrement())
  rfqId        Int
  supplierId   Int
  productId    Int?
  description  String      @db.VarChar(300)
  quantity     Decimal     @db.Decimal(14, 4)
  unitPrice    Decimal?    @db.Decimal(14, 2)
  leadTimeDays Int?
  notes        String?
  quotedAt     DateTime?
  rfq          PurchaseRFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier     Supplier    @relation("SupplierRFQLines", fields: [supplierId], references: [id])
  product      Product?    @relation(fields: [productId], references: [id])

  @@index([rfqId])
  @@index([supplierId])
  @@map("purchase_rfq_lines")
}

// ============================================================================
// ERP INDUSTRIAL - MANUFACTURA / PRODUCCIÓN
// ============================================================================

enum ProductionOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================================
// ERP INDUSTRIAL — DEFERRED P2 (schema theater, NOT product)
// Models retained for future MRP/Quality/HSE. Feature flags module.mrp|quality|hse = false.
// Do not expose Nest controllers / web nav until P2 ship decision.
// ============================================================================

model BillOfMaterials {
  id               Int                 @id @default(autoincrement())
  productId        Int
  version          String              @default("1.0") @db.VarChar(20)
  name             String              @db.VarChar(200)
  description      String?
  standardQty      Decimal             @default(1) @db.Decimal(14, 4)
  unitOfMeasure    String              @default("PZA") @db.VarChar(20)
  isActive         Boolean             @default(true)
  approvedById     Int?
  approvedAt       DateTime?
  companyId        Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  product          Product             @relation("ProductBOM", fields: [productId], references: [id])
  approvedBy       User?               @relation("BOMApprover", fields: [approvedById], references: [id])
  company          CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  components       BOMComponent[]
  routings         ProductionRouting[]
  productionOrders ProductionOrder[]

  @@unique([companyId, productId, version])
  @@index([companyId])
  @@map("bills_of_materials")
}

model BOMComponent {
  id                 Int             @id @default(autoincrement())
  bomId              Int
  componentProductId Int
  quantity           Decimal         @db.Decimal(14, 4)
  unitOfMeasure      String          @default("PZA") @db.VarChar(20)
  scrapPercent       Decimal         @default(0) @db.Decimal(5, 2)
  notes              String?
  sortOrder          Int             @default(0)
  bom                BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentProduct   Product         @relation("BOMComponentProduct", fields: [componentProductId], references: [id])

  @@index([bomId])
  @@map("bom_components")
}

model WorkCenter {
  id              Int                 @id @default(autoincrement())
  code            String              @db.VarChar(20)
  name            String              @db.VarChar(200)
  description     String?
  costPerHour     Decimal             @default(0) @db.Decimal(12, 2)
  capacityPerHour Decimal             @default(1) @db.Decimal(10, 2)
  isActive        Boolean             @default(true)
  companyId       Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  routings        ProductionRouting[]
  productionLogs  ProductionLog[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("work_centers")
}

model ProductionRouting {
  id              Int             @id @default(autoincrement())
  bomId           Int
  operationNumber Int
  workCenterId    Int
  operationName   String          @db.VarChar(200)
  description     String?
  setupTimeMin    Int             @default(0)
  runTimeMin      Int             @default(0)
  sortOrder       Int             @default(0)
  bom             BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter      @relation(fields: [workCenterId], references: [id])

  @@unique([bomId, operationNumber])
  @@map("production_routings")
}

model ProductionOrder {
  id               Int                   @id @default(autoincrement())
  orderNumber      String                @db.VarChar(30)
  bomId            Int
  productId        Int
  status           ProductionOrderStatus @default(PLANNED)
  plannedQty       Decimal               @db.Decimal(14, 4)
  completedQty     Decimal               @default(0) @db.Decimal(14, 4)
  scrapQty         Decimal               @default(0) @db.Decimal(14, 4)
  plannedStartDate DateTime?             @db.Date
  plannedEndDate   DateTime?             @db.Date
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  estimatedCost    Decimal               @default(0) @db.Decimal(14, 2)
  actualCost       Decimal               @default(0) @db.Decimal(14, 2)
  priority         String                @default("NORMAL") @db.VarChar(20)
  notes            String?
  createdById      Int?
  companyId        Int
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  bom              BillOfMaterials       @relation(fields: [bomId], references: [id])
  product          Product               @relation(fields: [productId], references: [id])
  createdBy        User?                 @relation("ProductionOrderCreator", fields: [createdById], references: [id])
  company          CompanyProfile        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  logs             ProductionLog[]
  stockMovements   StockMovement[]

  @@unique([companyId, orderNumber])
  @@index([status])
  @@index([companyId])
  @@map("production_orders")
}

model ProductionLog {
  id                Int             @id @default(autoincrement())
  productionOrderId Int
  workCenterId      Int
  operatorId        Int?
  operationName     String          @db.VarChar(200)
  startTime         DateTime
  endTime           DateTime?
  quantityProduced  Decimal         @default(0) @db.Decimal(14, 4)
  quantityScrapped  Decimal         @default(0) @db.Decimal(14, 4)
  laborCost         Decimal         @default(0) @db.Decimal(12, 2)
  materialCost      Decimal         @default(0) @db.Decimal(12, 2)
  overheadCost      Decimal         @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime        @default(now())
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenter        WorkCenter      @relation(fields: [workCenterId], references: [id])
  operator          User?           @relation("ProductionLogOperator", fields: [operatorId], references: [id])

  @@index([productionOrderId])
  @@map("production_logs")
}

// ============================================================================
// ERP INDUSTRIAL - CALIDAD (Quality Management)
// ============================================================================

enum QualityInspectionType {
  INCOMING
  IN_PROCESS
  FINAL
  RANDOM
}

enum QualityInspectionResult {
  PASSED
  FAILED
  CONDITIONAL
}

enum NCRStatus {
  OPEN
  INVESTIGATING
  CORRECTIVE_ACTION
  RESOLVED
  CLOSED
}

enum NCRSeverity {
  MINOR
  MAJOR
  CRITICAL
}

model QualityInspection {
  id                Int                      @id @default(autoincrement())
  inspectionNumber  String                   @db.VarChar(30)
  type              QualityInspectionType
  result            QualityInspectionResult?
  productId         Int?
  lotId             Int?
  purchaseOrderId   Int?
  productionOrderId Int?
  inspectedQty      Decimal                  @db.Decimal(14, 4)
  passedQty         Decimal                  @default(0) @db.Decimal(14, 4)
  failedQty         Decimal                  @default(0) @db.Decimal(14, 4)
  inspectionDate    DateTime                 @db.Date
  inspectorId       Int?
  notes             String?
  reportUrl         String?                  @db.VarChar(500)
  companyId         Int
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?
  product           Product?                 @relation(fields: [productId], references: [id])
  lot               Lot?                     @relation(fields: [lotId], references: [id])
  inspector         User?                    @relation("QualityInspector", fields: [inspectorId], references: [id])
  company           CompanyProfile           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  checklistItems    QualityChecklistItem[]
  ncrs              NonConformanceReport[]

  @@unique([companyId, inspectionNumber])
  @@index([type, result])
  @@index([companyId])
  @@map("quality_inspections")
}

model QualityChecklistItem {
  id            Int               @id @default(autoincrement())
  inspectionId  Int
  parameter     String            @db.VarChar(200)
  specification String?           @db.VarChar(300)
  actualValue   String?           @db.VarChar(300)
  passed        Boolean           @default(true)
  notes         String?
  sortOrder     Int               @default(0)
  inspection    QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("quality_checklist_items")
}

model NonConformanceReport {
  id               Int                @id @default(autoincrement())
  ncrNumber        String             @db.VarChar(30)
  status           NCRStatus          @default(OPEN)
  severity         NCRSeverity        @default(MINOR)
  title            String             @db.VarChar(300)
  description      String
  rootCause        String?
  correctiveAction String?
  preventiveAction String?
  inspectionId     Int?
  productId        Int?
  reportedById     Int
  assignedToId     Int?
  resolvedAt       DateTime?
  closedAt         DateTime?
  companyId        Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  inspection       QualityInspection? @relation(fields: [inspectionId], references: [id])
  product          Product?           @relation(fields: [productId], references: [id])
  reportedBy       User               @relation("NCRReportedBy", fields: [reportedById], references: [id])
  assignedTo       User?              @relation("NCRAssignedTo", fields: [assignedToId], references: [id])
  company          CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, ncrNumber])
  @@index([status, severity])
  @@index([companyId])
  @@map("non_conformance_reports")
}

// ============================================================================
// ERP INDUSTRIAL - MANTENIMIENTO (CMMS)
// ============================================================================

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum AssetStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

model Asset {
  id                   Int                   @id @default(autoincrement())
  code                 String                @db.VarChar(30)
  name                 String                @db.VarChar(200)
  description          String?
  category             String?               @db.VarChar(100)
  location             String?               @db.VarChar(200)
  manufacturer         String?               @db.VarChar(200)
  model                String?               @db.VarChar(200)
  serialNumber         String?               @db.VarChar(100)
  purchaseDate         DateTime?             @db.Date
  purchaseCost         Decimal?              @db.Decimal(14, 2)
  warrantyExpiry       DateTime?             @db.Date
  expectedLifeYears    Int?
  status               AssetStatus           @default(OPERATIONAL)
  imageUrl             String?               @db.VarChar(500)
  responsibleId        Int?
  parentAssetId        Int?
  companyId            Int
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  responsible          User?                 @relation("AssetResponsible", fields: [responsibleId], references: [id])
  parentAsset          Asset?                @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets          Asset[]               @relation("AssetHierarchy")
  company              CompanyProfile        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  maintenanceOrders    MaintenanceOrder[]
  maintenanceSchedules MaintenanceSchedule[]

  @@unique([companyId, code])
  @@index([status])
  @@index([companyId])
  @@map("assets")
}

model MaintenanceSchedule {
  id                Int                @id @default(autoincrement())
  assetId           Int
  type              MaintenanceType    @default(PREVENTIVE)
  title             String             @db.VarChar(200)
  description       String?
  frequencyDays     Int
  lastExecutedAt    DateTime?
  nextDueDate       DateTime           @db.Date
  isActive          Boolean            @default(true)
  companyId         Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  asset             Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company           CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  maintenanceOrders MaintenanceOrder[]

  @@index([nextDueDate])
  @@index([companyId])
  @@map("maintenance_schedules")
}

model MaintenanceOrder {
  id              Int                    @id @default(autoincrement())
  orderNumber     String                 @db.VarChar(30)
  assetId         Int
  scheduleId      Int?
  type            MaintenanceType
  status          MaintenanceStatus      @default(PLANNED)
  priority        String                 @default("NORMAL") @db.VarChar(20)
  title           String                 @db.VarChar(200)
  description     String?
  diagnosis       String?
  workPerformed   String?
  plannedDate     DateTime               @db.Date
  completedDate   DateTime?
  downTimeMinutes Int?
  laborCost       Decimal                @default(0) @db.Decimal(12, 2)
  partsCost       Decimal                @default(0) @db.Decimal(12, 2)
  totalCost       Decimal                @default(0) @db.Decimal(12, 2)
  assignedToId    Int?
  createdById     Int?
  companyId       Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  asset           Asset                  @relation(fields: [assetId], references: [id])
  schedule        MaintenanceSchedule?   @relation(fields: [scheduleId], references: [id])
  assignedTo      User?                  @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])
  createdBy       User?                  @relation("MaintenanceCreator", fields: [createdById], references: [id])
  company         CompanyProfile         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parts           MaintenanceOrderPart[]

  @@unique([companyId, orderNumber])
  @@index([assetId, status])
  @@index([companyId])
  @@map("maintenance_orders")
}

model MaintenanceOrderPart {
  id                 Int              @id @default(autoincrement())
  maintenanceOrderId Int
  productId          Int?
  partName           String           @db.VarChar(200)
  quantity           Decimal          @db.Decimal(14, 4)
  unitCost           Decimal          @default(0) @db.Decimal(14, 2)
  totalCost          Decimal          @default(0) @db.Decimal(14, 2)
  maintenanceOrder   MaintenanceOrder @relation(fields: [maintenanceOrderId], references: [id], onDelete: Cascade)
  product            Product?         @relation(fields: [productId], references: [id])

  @@map("maintenance_order_parts")
}

// ============================================================================
// ERP INDUSTRIAL - SEGURIDAD INDUSTRIAL (EHS / Safety)
// ============================================================================

enum IncidentSeverity {
  NEAR_MISS
  FIRST_AID
  MEDICAL
  LOST_TIME
  FATALITY
}

enum IncidentStatus {
  REPORTED
  INVESTIGATING
  CORRECTIVE_ACTION
  CLOSED
}

enum WorkPermitType {
  HOT_WORK
  CONFINED_SPACE
  HEIGHTS
  ELECTRICAL
  EXCAVATION
  GENERAL
}

enum WorkPermitStatus {
  REQUESTED
  APPROVED
  ACTIVE
  EXPIRED
  CANCELLED
}

model SafetyIncident {
  id               Int              @id @default(autoincrement())
  incidentNumber   String           @db.VarChar(30)
  title            String           @db.VarChar(300)
  description      String
  severity         IncidentSeverity
  status           IncidentStatus   @default(REPORTED)
  incidentDate     DateTime
  location         String?          @db.VarChar(200)
  rootCause        String?
  correctiveAction String?
  reportedById     Int
  assignedToId     Int?
  resolvedAt       DateTime?
  companyId        Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  reportedBy       User             @relation("IncidentReporter", fields: [reportedById], references: [id])
  assignedTo       User?            @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  company          CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, incidentNumber])
  @@index([severity, status])
  @@index([companyId])
  @@map("safety_incidents")
}

model WorkPermit {
  id            Int              @id @default(autoincrement())
  permitNumber  String           @db.VarChar(30)
  type          WorkPermitType
  status        WorkPermitStatus @default(REQUESTED)
  title         String           @db.VarChar(200)
  description   String?
  location      String?          @db.VarChar(200)
  validFrom     DateTime
  validTo       DateTime
  requestedById Int
  approvedById  Int?
  approvedAt    DateTime?
  companyId     Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  requestedBy   User             @relation("PermitRequester", fields: [requestedById], references: [id])
  approvedBy    User?            @relation("PermitApprover", fields: [approvedById], references: [id])
  company       CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, permitNumber])
  @@index([type, status])
  @@index([companyId])
  @@map("work_permits")
}

model TrainingRecord {
  id             Int            @id @default(autoincrement())
  userId         Int
  courseName     String         @db.VarChar(200)
  description    String?
  provider       String?        @db.VarChar(200)
  completedDate  DateTime       @db.Date
  expirationDate DateTime?      @db.Date
  certificateUrl String?        @db.VarChar(500)
  score          Decimal?       @db.Decimal(5, 2)
  status         String         @default("VALID") @db.VarChar(30)
  companyId      Int
  createdAt      DateTime       @default(now())
  user           User           @relation("UserTraining", fields: [userId], references: [id])
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId, expirationDate])
  @@index([companyId])
  @@map("training_records")
}

// ============================================================================
// ERP INDUSTRIAL - GESTIÓN DOCUMENTAL (DMS)
// ============================================================================

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  OBSOLETE
}

model DocumentCategory {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(100)
  description String?
  parentId    Int?
  companyId   Int
  createdAt   DateTime           @default(now())
  parent      DocumentCategory?  @relation("DocCategoryHierarchy", fields: [parentId], references: [id])
  children    DocumentCategory[] @relation("DocCategoryHierarchy")
  documents   ManagedDocument[]
  company     CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("document_categories")
}

model ManagedDocument {
  id             Int               @id @default(autoincrement())
  documentNumber String            @db.VarChar(40)
  title          String            @db.VarChar(300)
  description    String?
  categoryId     Int?
  status         DocumentStatus    @default(DRAFT)
  currentVersion Int               @default(1)
  fileUrl        String?           @db.VarChar(500)
  mimeType       String?           @db.VarChar(100)
  fileSizeBytes  Int?
  retentionDays  Int?
  expiresAt      DateTime?
  createdById    Int
  approvedById   Int?
  approvedAt     DateTime?
  companyId      Int
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  category       DocumentCategory? @relation(fields: [categoryId], references: [id])
  createdBy      User              @relation("DocumentCreator", fields: [createdById], references: [id])
  approvedBy     User?             @relation("DocumentApprover", fields: [approvedById], references: [id])
  company        CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  versions       DocumentVersion[]
  chatChannel    ChatChannel?

  @@unique([companyId, documentNumber])
  @@index([status])
  @@index([companyId])
  @@map("managed_documents")
}

model DocumentVersion {
  id            Int             @id @default(autoincrement())
  documentId    Int
  versionNumber Int
  fileUrl       String          @db.VarChar(500)
  changelog     String?
  createdById   Int
  createdAt     DateTime        @default(now())
  document      ManagedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy     User            @relation("DocumentVersionCreator", fields: [createdById], references: [id])

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

// ============================================================================
// ERP INDUSTRIAL - WORKFLOW ENGINE
// ============================================================================

enum WorkflowStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

model WorkflowDefinition {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(200)
  description String?
  entityType  String             @db.VarChar(100)
  status      WorkflowStatus     @default(ACTIVE)
  companyId   Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  steps       WorkflowStep[]
  instances   WorkflowInstance[]
  company     CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, entityType, status])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id                   Int                @id @default(autoincrement())
  workflowId           Int
  stepNumber           Int
  name                 String             @db.VarChar(200)
  description          String?
  approverRoleId       Int?
  approverUserId       Int?
  autoApproveCondition String?
  timeoutHours         Int?
  sortOrder            Int                @default(0)
  workflow             WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverRole         Role?              @relation("WorkflowStepRole", fields: [approverRoleId], references: [id])
  approverUser         User?              @relation("WorkflowStepApprover", fields: [approverUserId], references: [id])
  approvals            WorkflowApproval[]

  @@unique([workflowId, stepNumber])
  @@map("workflow_steps")
}

model WorkflowInstance {
  id          Int                @id @default(autoincrement())
  workflowId  Int
  entityId    Int
  entityType  String             @db.VarChar(100)
  currentStep Int                @default(1)
  isComplete  Boolean            @default(false)
  isCancelled Boolean            @default(false)
  startedById Int
  companyId   Int
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  workflow    WorkflowDefinition @relation(fields: [workflowId], references: [id])
  startedBy   User               @relation("WorkflowStarter", fields: [startedById], references: [id])
  company     CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  approvals   WorkflowApproval[]

  @@index([entityType, entityId])
  @@index([companyId])
  @@map("workflow_instances")
}

model WorkflowApproval {
  id          Int              @id @default(autoincrement())
  instanceId  Int
  stepId      Int
  status      ApprovalStatus   @default(PENDING)
  comments    String?
  decidedById Int?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step        WorkflowStep     @relation(fields: [stepId], references: [id])
  decidedBy   User?            @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([instanceId, status])
  @@map("workflow_approvals")
}

// ============================================================================
// ERP INDUSTRIAL - AUDIT TRAIL
// ============================================================================

model AuditLog {
  id           Int             @id @default(autoincrement())
  entityType   String          @db.VarChar(100)
  entityId     Int
  action       String          @db.VarChar(50)
  changes      Json?
  previousData Json?
  userId       Int?
  companyId    Int?
  source       String          @default("http") @db.VarChar(30)
  ipAddress    String?         @db.VarChar(45)
  userAgent    String?         @db.VarChar(500)
  createdAt    DateTime        @default(now())
  user         User?           @relation("AuditLogUser", fields: [userId], references: [id])
  company      CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([companyId])
  @@index([source])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// ERP INDUSTRIAL - BI / ANALYTICS (KPI Snapshots)
// ============================================================================

model KpiSnapshot {
  id          Int             @id @default(autoincrement())
  kpiName     String          @db.VarChar(100)
  kpiCategory String          @db.VarChar(60)
  value       Decimal         @db.Decimal(16, 4)
  unit        String?         @db.VarChar(30)
  periodStart DateTime        @db.Date
  periodEnd   DateTime        @db.Date
  metadata    Json?
  /// Null only for PUBLIC_TRAFFIC (landing anónima). KPIs de producto exigen companyId.
  companyId   Int?
  createdAt   DateTime        @default(now())
  company     CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([kpiName, periodStart])
  @@index([kpiCategory])
  @@index([companyId])
  @@map("kpi_snapshots")
}

// ============================================================================
// CONFIGURACIÓN DEL SISTEMA
// ============================================================================

model SystemSetting {
  id        Int             @id @default(autoincrement())
  key       String          @db.VarChar(120)
  value     String          @db.Text
  category  String          @db.VarChar(60)
  label     String?         @db.VarChar(200)
  /// Null = setting de plataforma. Set = override por tenant.
  companyId Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  company   CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([key, companyId])
  @@index([category])
  @@index([companyId])
  @@map("system_settings")
}

model UserPreference {
  id        Int      @id @default(autoincrement())
  userId    Int
  key       String   @db.VarChar(120)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserPreferences", fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

/// Tokens FCM (APK) y suscripciones Web Push (navegador) para alertas fuera de la app.
model UserPushEndpoint {
  id              Int      @id @default(autoincrement())
  userId          Int
  fcmToken        String?  @unique @db.VarChar(512)
  webPushEndpoint String?  @unique @db.VarChar(2048)
  webPushKeys     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("UserPushEndpoint")
}

// ============================================================================
// HR MODULE — Leave Requests & Performance Reviews
// ============================================================================

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id              Int         @id @default(autoincrement())
  userId          Int
  type            LeaveType
  status          LeaveStatus @default(PENDING)
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  days            Float
  reason          String?     @db.Text
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?     @db.VarChar(500)
  companyId       Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user       User           @relation("LeaveRequester", fields: [userId], references: [id])
  approvedBy User?          @relation("LeaveApprover", fields: [approvedById], references: [id])
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([companyId])
  @@map("leave_requests")
}

enum ReviewPeriod {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

model PerformanceReview {
  id                 Int          @id @default(autoincrement())
  userId             Int
  reviewerId         Int
  period             ReviewPeriod
  reviewDate         DateTime     @db.Date
  overallRating      Float
  strengths          String?      @db.Text
  areasOfImprovement String?      @db.Text
  goals              String?      @db.Text
  status             ReviewStatus @default(DRAFT)
  comments           String?      @db.Text
  companyId          Int
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user     User           @relation("ReviewedUser", fields: [userId], references: [id])
  reviewer User           @relation("Reviewer", fields: [reviewerId], references: [id])
  company  CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([reviewerId])
  @@index([period, reviewDate])
  @@index([companyId])
  @@map("performance_reviews")
}

// ============================================================================
// FASE 9 — CONTRATOS DE MANTENIMIENTO RECURRENTE (SLA + OT automáticas)
// ============================================================================

enum MaintenanceContractStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum MaintenanceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum MaintenanceContractVisitStatus {
  SCHEDULED
  GENERATED
  COMPLETED
  SKIPPED
}

model MaintenanceContract {
  id                   Int                       @id @default(autoincrement())
  contractNumber       String                    @db.VarChar(40)
  clientId             Int
  branchId             Int?
  ownerId              Int?
  companyId            Int
  title                String                    @db.VarChar(200)
  description          String?
  serviceScope         String?
  frequency            MaintenanceFrequency
  // SLA en horas para acudir tras alta del ticket / próxima visita.
  slaResponseHours     Int                       @default(48)
  slaResolutionHours   Int                       @default(72)
  monthlyFee           Decimal                   @default(0) @db.Decimal(12, 2)
  currency             String                    @default("MXN") @db.VarChar(3)
  startDate            DateTime                  @db.Date
  endDate              DateTime?                 @db.Date
  nextVisitDate        DateTime?                 @db.Date
  status               MaintenanceContractStatus @default(ACTIVE)
  autoGenerateOt       Boolean                   @default(true)
  notifyHoursBefore    Int                       @default(24)
  notes                String?
  /// Proyecto OPS dedicado a este contrato (no reutilizar proyectos comerciales del cliente).
  operationalProjectId Int?                      @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  deletedAt            DateTime?

  client             ServiceClient              @relation(fields: [clientId], references: [id])
  branch             ServiceClientBranch?       @relation(fields: [branchId], references: [id])
  owner              User?                      @relation("MaintenanceContractOwner", fields: [ownerId], references: [id])
  company            CompanyProfile             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operationalProject OperationalProject?        @relation("MaintenanceContractProject", fields: [operationalProjectId], references: [id], onDelete: SetNull)
  visits             MaintenanceContractVisit[]

  @@unique([companyId, contractNumber])
  @@index([status, nextVisitDate])
  @@index([clientId, status])
  @@index([companyId])
  @@map("maintenance_contracts")
}

model MaintenanceContractVisit {
  id                   Int                            @id @default(autoincrement())
  contractId           Int
  scheduledDate        DateTime                       @db.Date
  status               MaintenanceContractVisitStatus @default(SCHEDULED)
  generatedAt          DateTime?
  completedAt          DateTime?
  operationalProjectId Int?
  activityId           Int?
  assignedToId         Int?
  notes                String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  contract   MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assignedTo User?               @relation("MaintenanceVisitAssignee", fields: [assignedToId], references: [id])
  companyId  Int
  company    CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([contractId, scheduledDate])
  @@index([status, scheduledDate])
  @@index([companyId])
  @@map("maintenance_contract_visits")
}

// ============================================================================
// FASE 11 — LICITACIONES (TENDERS) Sector público y privado
// ============================================================================

enum TenderType {
  PUBLIC_GOV
  PRIVATE
  INVITATION
  CONSOLIDATED
}

enum TenderStatus {
  PROSPECT
  IN_REVIEW
  PREPARING_BID
  SUBMITTED
  AWARDED
  LOST
  CANCELLED
  DISQUALIFIED
}

model Tender {
  id                    Int          @id @default(autoincrement())
  tenderNumber          String       @db.VarChar(60)
  title                 String       @db.VarChar(220)
  description           String?
  tenderType            TenderType   @default(PUBLIC_GOV)
  status                TenderStatus @default(PROSPECT)
  // Datos del convocante (gobierno / empresa)
  conveningEntity       String       @db.VarChar(220)
  conveningContact      String?      @db.VarChar(180)
  conveningEmail        String?      @db.VarChar(180)
  conveningPhone        String?      @db.VarChar(60)
  publicationUrl        String?      @db.VarChar(500)
  // CompraNet u otro identificador externo
  externalReference     String?      @db.VarChar(160)
  // Montos
  budgetCeiling         Decimal      @default(0) @db.Decimal(16, 2)
  ourBidAmount          Decimal      @default(0) @db.Decimal(16, 2)
  estimatedCost         Decimal      @default(0) @db.Decimal(16, 2)
  expectedMargin        Decimal      @default(0) @db.Decimal(16, 2)
  guaranteeAmount       Decimal      @default(0) @db.Decimal(16, 2)
  currency              String       @default("MXN") @db.VarChar(3)
  // Fechas críticas
  publishDate           DateTime?    @db.Date
  questionsDeadline     DateTime?
  submissionDeadline    DateTime?
  openingDate           DateTime?
  awardDate             DateTime?
  contractStartDate     DateTime?    @db.Date
  contractEndDate       DateTime?    @db.Date
  // Operativo
  scope                 String?
  technicalRequirements String?
  legalRequirements     String?
  ownerId               Int?
  salesOpportunityId    Int?         @unique
  awardedToCompetitor   String?      @db.VarChar(220)
  awardNotes            String?
  companyId             Int
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  owner         User?             @relation("TenderOwner", fields: [ownerId], references: [id])
  opportunity   SalesOpportunity? @relation(fields: [salesOpportunityId], references: [id])
  company       CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documents     TenderDocument[]
  events        TenderEvent[]
  crmActivities CrmActivity[]

  @@unique([companyId, tenderNumber])
  @@index([status, submissionDeadline])
  @@index([tenderType])
  @@index([companyId])
  @@map("tenders")
}

enum TenderDocumentType {
  CONVOCATORIA
  BASES
  ANEXO_TECNICO
  PROPUESTA_TECNICA
  PROPUESTA_ECONOMICA
  ACTA_PRESENTACION
  FALLO
  CONTRATO
  GARANTIA
  OTRO
}

model TenderDocument {
  id           Int                @id @default(autoincrement())
  tenderId     Int
  documentType TenderDocumentType
  name         String             @db.VarChar(200)
  url          String?            @db.VarChar(500)
  uploadedBy   Int?
  notes        String?
  createdAt    DateTime           @default(now())
  tender       Tender             @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId, documentType])
  @@map("tender_documents")
}

model TenderEvent {
  id          Int      @id @default(autoincrement())
  tenderId    Int
  eventName   String   @db.VarChar(160)
  description String?
  occursAt    DateTime
  createdAt   DateTime @default(now())
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId, occursAt])
  @@map("tender_events")
}

// ============================================================================
// FASE 17 — CRM ACTIVITIES (follow-ups, tasks, calls)
// ============================================================================

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  WHATSAPP
  VISIT
  NOTE
}

enum CrmActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
  OVERDUE
}

model CrmActivity {
  id            Int               @id @default(autoincrement())
  activityType  CrmActivityType   @default(TASK)
  status        CrmActivityStatus @default(PENDING)
  subject       String            @db.VarChar(220)
  description   String?
  dueDate       DateTime
  completedAt   DateTime?
  outcome       String?
  // Polimórfico — apunta a Lead o Opportunity o Tender
  leadId        Int?
  opportunityId Int?
  tenderId      Int?
  // Asignación
  ownerId       Int?
  createdById   Int?
  // Recordatorio
  remindAt      DateTime?
  reminderSent  Boolean           @default(false)
  companyId     Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  lead        SalesLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity SalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  tender      Tender?           @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  owner       User?             @relation("CrmActivityOwner", fields: [ownerId], references: [id])
  createdBy   User?             @relation("CrmActivityCreator", fields: [createdById], references: [id])
  company     CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, dueDate])
  @@index([leadId])
  @@index([opportunityId])
  @@index([tenderId])
  @@index([companyId])
  @@map("crm_activities")
}

// ============================================================================
// FASE 18 — SALES TARGETS & COMMISSIONS
// ============================================================================

enum SalesTargetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

model SalesTarget {
  id                  Int               @id @default(autoincrement())
  ownerId             Int
  period              SalesTargetPeriod @default(MONTHLY)
  year                Int
  month               Int? // 1-12 si MONTHLY
  quarter             Int? // 1-4 si QUARTERLY
  // Metas
  revenueTarget       Decimal           @default(0) @db.Decimal(14, 2)
  newClientsTarget    Int               @default(0)
  opportunitiesTarget Int               @default(0)
  // Comisiones
  baseCommissionPct   Decimal           @default(0) @db.Decimal(5, 2)
  bonusCommissionPct  Decimal           @default(0) @db.Decimal(5, 2)
  bonusThresholdPct   Decimal           @default(100) @db.Decimal(5, 2) // 100% = al alcanzar la meta
  notes               String?
  companyId           Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  owner   User           @relation("SalesTargetOwner", fields: [ownerId], references: [id])
  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, ownerId, period, year, month, quarter])
  @@index([year, month])
  @@index([companyId])
  @@map("sales_targets")
}

// ============================================================================
// FASE 19 — KNOWLEDGE BASE (FAQ pública / portal cliente)
// ============================================================================

enum KbVisibility {
  PUBLIC
  CLIENT_ONLY
  INTERNAL
}

enum KbArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KbCategory {
  id          Int            @id @default(autoincrement())
  slug        String         @db.VarChar(120)
  name        String         @db.VarChar(180)
  description String?
  icon        String?        @db.VarChar(60)
  visibility  KbVisibility   @default(PUBLIC)
  sortOrder   Int            @default(0)
  parentId    Int?
  companyId   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      KbCategory?    @relation("KbCategoryHierarchy", fields: [parentId], references: [id])
  children    KbCategory[]   @relation("KbCategoryHierarchy")
  articles    KbArticle[]
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("kb_categories")
}

model KbArticle {
  id           Int             @id @default(autoincrement())
  slug         String          @db.VarChar(180)
  title        String          @db.VarChar(220)
  excerpt      String?
  content      String          @db.Text
  visibility   KbVisibility    @default(PUBLIC)
  status       KbArticleStatus @default(DRAFT)
  categoryId   Int?
  authorId     Int?
  tags         String?         @db.VarChar(400) // CSV
  viewCount    Int             @default(0)
  helpfulCount Int             @default(0)
  publishedAt  DateTime?
  companyId    Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  category KbCategory?    @relation(fields: [categoryId], references: [id])
  author   User?          @relation("KbArticleAuthor", fields: [authorId], references: [id])
  company  CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([companyId])
  @@map("kb_articles")
}

