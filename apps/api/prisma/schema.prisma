  cliente     String         @db.VarChar(200)
  vertical    String         @db.VarChar(80)
  impacto     String         @db.VarChar(500)
  descripcion String?        @db.Text
  cover       String?        @db.VarChar(10)
  imageUrl    String?        @db.VarChar(500)
  publicado   Boolean        @default(false)
  autorId     Int
  companyId   Int
  autor       User           @relation("CaseStudyAuthor", fields: [autorId], references: [id])
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, slug])
  @@index([publicado])
  @@index([slug])
  @@index([companyId])
}

// ============================================================================
// POSTS DE REDES SOCIALES (studio/social — calendario editorial)
// ============================================================================
model SocialPost {
  id            Int            @id @default(autoincrement())
  red           String         @db.VarChar(40)
  titulo        String         @db.VarChar(300)
  contenido     String?        @db.Text
  mediaUrl      String?        @db.VarChar(500)
  cuando        DateTime
  estado        String         @default("Borrador") @db.VarChar(30)
  autorId       Int
  companyId     Int
