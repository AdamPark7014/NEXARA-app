  deviceType  String?           @db.VarChar(80)
  raw         Json?
  syncedAt    DateTime          @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, kind, indexCode])
  @@index([companyId])
  @@map("integra_devices")
}

model IntegraVehicle {
  id         Int      @id @default(autoincrement())
  companyId  Int
  siteId     Int
  vehicleId  String   @db.VarChar(120)
  plateNo    String   @db.VarChar(40)
  personId   String?  @db.VarChar(120)
  personName String?  @db.VarChar(220)
  raw        Json?
  syncedAt   DateTime @default(now())

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    IntegraSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, vehicleId])
  @@index([companyId])
