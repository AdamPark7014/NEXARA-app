}

model IntegraSyncRun {
  id         Int               @id @default(autoincrement())
  companyId  Int
  siteId     Int
  status     IntegraSyncStatus @default(RUNNING)
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  cameras    Int               @default(0)
  doors      Int               @default(0)
  people     Int               @default(0)
  devices    Int               @default(0)
