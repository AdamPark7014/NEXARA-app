# ── Web Push (par VAPID, solo servidor) ──────────────────────────────────────
# Generar:  npm run generate:vapid   (desde apps/api)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:soporte@nexara.com.mx

# ── Facturación CFDI 4.0 / SAT ───────────────────────────────────────────────
# PAC (Proveedor Autorizado de Certificación) — timbrado vía internet (HTTPS TLS 1.2+)
# En producción: PAC_PROVIDER=facturama|sw|finkok  y  PAC_FALLBACK_TO_MOCK=0
PAC_PROVIDER=mock
PAC_FALLBACK_TO_MOCK=1

# ── Facturama (REST/JSON — sella con CSD en bóveda Facturama) ────────────────
# FACTURAMA_USER=
# FACTURAMA_PASSWORD=
# FACTURAMA_BASE_URL=https://apisandbox.facturama.mx

# ── SW Sapien (REST — issue JSON o XML pre-sellado) ────────────────────────
# SW_TOKEN=
# SW_USER=
# SW_PASSWORD=
# SW_BASE_URL=https://services.test.sw.com.mx
# SW_USE_ISSUE_JSON=1

# ── Finkok (SOAP — requiere XML pre-sellado con CSD local) ───────────────────
# FINKOK_USER=
# FINKOK_PASSWORD=
# FINKOK_BASE_URL=https://demo-facturacion.finkok.com

# ── CSD — Certificado de Sello Digital (OBLIGATORIO para sellado local) ─────
# Distinto de e.firma. El CSD sella facturas; la e.firma autentica ante el SAT.
# Modo A: contenido base64 (recomendado en Docker)
# CSD_CER_BASE64=
# CSD_KEY_BASE64=
# CSD_KEY_PASSWORD=
# Modo B: rutas a archivos montados
# CSD_CER_PATH=/run/secrets/csd.cer
# CSD_KEY_PATH=/run/secrets/csd.key

# ── e.firma / FIEL (para Descarga Masiva SAT — WS-Security SOAP) ─────────────
# Distinto del CSD. Solo para autenticación en servicios SAT (Descarga Masiva).
# EFIRMA_CER_BASE64=
# EFIRMA_KEY_BASE64=
# EFIRMA_KEY_PASSWORD=
# EFIRMA_CER_PATH=/run/secrets/efirma.cer
# EFIRMA_KEY_PATH=/run/secrets/efirma.key
