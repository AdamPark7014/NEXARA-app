# ── Web Push (par VAPID, solo servidor) ──────────────────────────────────────
# Generar:  npm run generate:vapid   (desde apps/api)
# La clave pública debe copiarse también a apps/web como NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Contacto incluido en el JWT VAPID (visible para push providers). Usa un correo real de soporte.
WEB_PUSH_CONTACT=mailto:soporte@nexara.com.mx
