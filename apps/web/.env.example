# ── Web Push (navegador con pestaña cerrada) ────────────────────────────────
# Genera un par VAPID en el API:  cd apps/api && npm run generate:vapid
# Copia la clave PÚBLICA aquí (misma que WEB_PUSH_VAPID_PUBLIC_KEY del API).
# Sin esta variable: sigues teniendo notificaciones en la app + espejo en vivo si el usuario da permiso,
# pero NO llegan pushes cuando no hay pestaña abierta.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# Opcional: muestra un banner propio antes de abrir el diálogo del navegador (recomendado en producción).
# Valores: banner | (vacío = al entrar a consola/ventas se intenta permiso + suscripción en cuanto exista la clave pública).
NEXT_PUBLIC_WEB_PUSH_CONSENT_MODE=banner

# ── Safari / iOS (PWA) ─────────────────────────────────────────────────────
# - Web Push en iOS: solo en iOS 16.4+ y con la app añadida a inicio (PWA); el usuario debe aceptar permisos.
# - Badging (contador en icono): soporte limitado; en muchos Safari no existe setAppBadge (el componente no hace nada).
# - Asegúrate de servir este sitio por HTTPS en producción (obligatorio para SW y push).
