## Traefik routing for ACROBAT - DEBUG MODE (HTTP only)

http:
  routers:
    acrobat-http:
      rule: 'Host(`acrobat.mx`, `www.acrobat.mx`)'
      entryPoints: [web]
      service: acrobat-app

  services:
    acrobat-app:
      loadBalancer:
        servers:
          - url: http://acrobat-app-app-1:80
