# Traefik v3.1 routing for Zynoratek (HTTP + HTTPS)

http:
  routers:
    zynoratek-http:
      rule: Host(`zynoratek.com`) || Host(`www.zynoratek.com`) || Host(`es.zynoratek.com`)
      entryPoints: [web, websecure]
      service: zynoratek-web
      tls: {}

    zynoratek-api-http:
      rule: Host(`api.zynoratek.com`)
      entryPoints: [web, websecure]
      service: zynoratek-api
      tls: {}

  services:
    zynoratek-web:
      loadBalancer:
        servers:
          - url: http://zynoratek-web-1:3000

    zynoratek-api:
      loadBalancer:
        servers:
          - url: http://zynoratek-api-1:3000
