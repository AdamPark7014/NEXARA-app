## Traefik routing for NEXARA ERP - DEBUG MODE (HTTP only, no HTTPS/ACME)

http:
  routers:
    # ───────────────────────────────────────────────────────────
    # Socket.IO backend (real-time)
    # ───────────────────────────────────────────────────────────
    socket-io:
      rule: 'Host(`core.nexara.com.mx`,`sales.nexara.com.mx`,`ops.nexara.com.mx`,`finance.nexara.com.mx`,`studio.nexara.com.mx`,`portal.nexara.com.mx`,`support.nexara.com.mx`,`noc.nexara.com.mx`,`people.nexara.com.mx`,`lab.nexara.com.mx`) && PathPrefix(`/socket.io`)'
      entryPoints: [web]
      service: nexara-api
      priority: 101

    # ───────────────────────────────────────────────────────────
    # Uploads estáticos (máxima prioridad)
    # ───────────────────────────────────────────────────────────
    uploads:
      rule: 'PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-api
      priority: 102

    # ───────────────────────────────────────────────────────────
    # API backend bajo /api
    # ───────────────────────────────────────────────────────────
    api:
      rule: 'Host(`core.nexara.com.mx`,`sales.nexara.com.mx`,`ops.nexara.com.mx`,`finance.nexara.com.mx`,`studio.nexara.com.mx`,`portal.nexara.com.mx`,`support.nexara.com.mx`,`noc.nexara.com.mx`,`people.nexara.com.mx`,`lab.nexara.com.mx`) && PathPrefix(`/api`)'
      entryPoints: [web]
      service: nexara-api
      priority: 100

    api-direct:
      rule: 'Host(`api.nexara.com.mx`)'
      entryPoints: [web]
      service: nexara-api

    # ───────────────────────────────────────────────────────────
    # Frontends (Next.js)
    # ───────────────────────────────────────────────────────────
    core-frontend:
      rule: 'Host(`core.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    sales-frontend:
      rule: 'Host(`sales.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    ops-frontend:
      rule: 'Host(`ops.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    finance-frontend:
      rule: 'Host(`finance.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    studio-frontend:
      rule: 'Host(`studio.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    portal-frontend:
      rule: 'Host(`portal.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    support-frontend:
      rule: 'Host(`support.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    noc-frontend:
      rule: 'Host(`noc.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    people-frontend:
      rule: 'Host(`people.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    lab-frontend:
      rule: 'Host(`lab.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 20

    erp-frontends:
      rule: 'Host(`core.nexara.com.mx`,`sales.nexara.com.mx`,`ops.nexara.com.mx`,`finance.nexara.com.mx`,`studio.nexara.com.mx`,`portal.nexara.com.mx`,`support.nexara.com.mx`,`noc.nexara.com.mx`,`people.nexara.com.mx`,`lab.nexara.com.mx`,`console.nexara.com.mx`,`app.nexara.com.mx`,`ventas.nexara.com.mx`,`contabilidad.nexara.com.mx`,`web.nexara.com.mx`,`tickets.nexara.com.mx`) && !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)'
      entryPoints: [web]
      service: nexara-web
      priority: 10

    # Sitio público
    public:
      rule: 'Host(`nexara.com.mx`,`www.nexara.com.mx`)'
      entryPoints: [web]
      service: nexara-web
      priority: 10

  services:
    nexara-web:
      loadBalancer:
        servers:
          - url: 'http://nexara-web:3000'

    nexara-api:
      loadBalancer:
        servers:
          - url: 'http://nexara-api:3001'
