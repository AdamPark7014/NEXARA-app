# Traefik v3.1 routing for NEXARA ERP (HTTP + HTTPS)
# Syntax: Host() || Host() for multiple hosts
# No ACME yet - serving both web and websecure entrypoints

http:
  routers:
    # Socket.IO (real-time) - priority 101
    socket-io:
      rule: >-
        (Host(`core.nexara.com.mx`) || Host(`sales.nexara.com.mx`) || 
         Host(`ops.nexara.com.mx`) || Host(`finance.nexara.com.mx`) || 
         Host(`studio.nexara.com.mx`) || Host(`portal.nexara.com.mx`) || 
         Host(`support.nexara.com.mx`) || Host(`noc.nexara.com.mx`) || 
         Host(`people.nexara.com.mx`) || Host(`lab.nexara.com.mx`)) && 
        PathPrefix(`/socket.io`)
      entryPoints: [web, websecure]
      service: nexara-api
      tls: {}
      priority: 101

    # Uploads (static files) - priority 102
    uploads:
      rule: PathPrefix(`/uploads`)
      entryPoints: [web, websecure]
      service: nexara-api
      tls: {}
      priority: 102

    # API backend under /api
    api:
      rule: >-
        (Host(`core.nexara.com.mx`) || Host(`sales.nexara.com.mx`) || 
         Host(`ops.nexara.com.mx`) || Host(`finance.nexara.com.mx`) || 
         Host(`studio.nexara.com.mx`) || Host(`portal.nexara.com.mx`) || 
         Host(`support.nexara.com.mx`) || Host(`noc.nexara.com.mx`) || 
         Host(`people.nexara.com.mx`) || Host(`lab.nexara.com.mx`)) && 
        PathPrefix(`/api`)
      entryPoints: [web, websecure]
      service: nexara-api
      tls: {}
      priority: 100

    # Direct API subdomain
    api-direct:
      rule: Host(`api.nexara.com.mx`)
      entryPoints: [web, websecure]
      service: nexara-api
      tls: {}
      priority: 99

    # Frontends - core ERP console
    studio-frontend:
      rule: >-
        Host(`studio.nexara.com.mx`) && 
        !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)
      entryPoints: [web, websecure]
      service: nexara-web
      tls: {}
      priority: 20

    api-frontend:
      rule: >-
        Host(`api.nexara.com.mx`) || Host(`core.nexara.com.mx`)
      entryPoints: [web, websecure]
      service: nexara-web
      tls: {}
      priority: 19

    # Catch-all for legacy aliases
    erp-frontend:
      rule: >-
        (Host(`core.nexara.com.mx`) || Host(`consola.nexara.com.mx`) || Host(`console.nexara.com.mx`) ||
         Host(`app.nexara.com.mx`) || Host(`sales.nexara.com.mx`) || Host(`ventas.nexara.com.mx`) ||
         Host(`crm.nexara.com.mx`) || Host(`ops.nexara.com.mx`) || Host(`operacion.nexara.com.mx`) ||
         Host(`finance.nexara.com.mx`) || Host(`contabilidad.nexara.com.mx`) || Host(`admin.nexara.com.mx`) ||
         Host(`media.nexara.com.mx`) || Host(`web.nexara.com.mx`) ||
         Host(`portal.nexara.com.mx`) || Host(`tickets.nexara.com.mx`) ||
         Host(`support.nexara.com.mx`) || Host(`help.nexara.com.mx`) ||
         Host(`noc.nexara.com.mx`) || Host(`monitor.nexara.com.mx`) ||
         Host(`people.nexara.com.mx`) || Host(`rh.nexara.com.mx`) || Host(`hr.nexara.com.mx`) ||
         Host(`lab.nexara.com.mx`) || Host(`dev.nexara.com.mx`)) && 
        !PathPrefix(`/api`) && !PathPrefix(`/socket.io`) && !PathPrefix(`/uploads`)
      entryPoints: [web, websecure]
      service: nexara-web
      tls: {}
      priority: 18

    # Public site
    public:
      rule: Host(`nexara.com.mx`) || Host(`www.nexara.com.mx`)
      entryPoints: [web, websecure]
      service: nexara-web
      tls: {}
      priority: 10

  services:
    nexara-api:
      loadBalancer:
        servers:
          - url: http://nexara-api:3001

    nexara-web:
      loadBalancer:
        servers:
          - url: http://nexara-web:3000
