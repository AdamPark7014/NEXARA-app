# Transcriptor propio de NEXARA: voz a texto en español con whisper.cpp, sin proveedores.
#
# El API le manda el audio por la red interna (`POST /inference`) y recibe el texto. Nada
# sale del servidor. Se compila aquí mismo con las instrucciones del CPU que lo corre
# (GGML_NATIVE), por eso la imagen se construye en el servidor, como las demás.
#
# Modelo (WHISPER_MODEL). Medido en este servidor (23-10-2026, 4 vCPU compartidos, banco con FLEURS
# es_419 de 22 voces; «sala» = voz lejana con eco y ruido; partes de 20 s como las sube la web):
#   modelo (partes de 20 s)          WER limpio  WER sala  × tiempo real (limpio/sala)  RAM
#   large-v3-turbo-q5_0, audio_ctx 1100   21.3 %     53.1 %    1.18 / 0.88               ~0.8 GB  ← por omisión
#   large-v3-turbo-q5_0, contexto entero  20.8 %     53.8 %    1.89 / 1.17
#   large-v3-turbo-q8_0                   20.8 %     52.8 %    1.61 / 0.77               ~1.0 GB
#   medium-q5_0                           24.9 %     62.1 %    1.58 / 1.05               ~0.7 GB
#   small (el de antes)                   22.3 %     65.5 %    0.30 / 0.23               ~0.6 GB
#   (× tiempo real con el servidor ocupado, carga 5–8; la voz leída no tiene pausas, una junta sí)
# El grande baja 12 puntos los errores con voz de sala; si el servidor va ocupado, queda unos
# minutos detrás de la junta y se pone al día al concluir. Banco: apps/api/scripts/banco-transcriptor.
FROM debian:bookworm-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

ARG WHISPER_VERSION=v1.9.5
RUN git clone --depth 1 --branch "${WHISPER_VERSION}" https://github.com/ggml-org/whisper.cpp /src
WORKDIR /src
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DWHISPER_BUILD_TESTS=OFF \
 && cmake --build build -j"$(nproc)" --target whisper-server

ARG WHISPER_MODEL=large-v3-turbo-q5_0
RUN mkdir -p /models \
 && sh ./models/download-ggml-model.sh "${WHISPER_MODEL}" /models \
 && sh ./models/download-vad-model.sh silero-v6.2.0 /models \
 && mv "/models/ggml-${WHISPER_MODEL}.bin" /models/modelo.bin \
 && test -s /models/modelo.bin && test -s /models/ggml-silero-v6.2.0.bin

FROM debian:bookworm-slim
# ffmpeg convierte lo que graban los navegadores (webm/ogg/mp4) a WAV de 16 kHz.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libgomp1 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --home /app transcriptor \
 && mkdir -p /app/tmp && chown transcriptor /app/tmp
COPY --from=build /src/build/bin/whisper-server /usr/local/bin/whisper-server
COPY --from=build /models /models
USER transcriptor
WORKDIR /app/tmp
ENV WHISPER_THREADS=4
EXPOSE 8080
# --vad recorta los silencios: menos tiempo de CPU y sin frases inventadas en los huecos.
ENV WHISPER_ARGS=""
CMD ["sh", "-c", "exec whisper-server --host 0.0.0.0 --port 8080 -m /models/modelo.bin -l es --convert -t ${WHISPER_THREADS} --vad -vm /models/ggml-silero-v6.2.0.bin ${WHISPER_ARGS}"]
