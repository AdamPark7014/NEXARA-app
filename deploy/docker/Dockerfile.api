# Se compila con todo lo de la API y la imagen final solo lleva lo de producción. Las dependencias de la web
# no entran en ninguna etapa: el 02-11-2026 eran 1.5 GB de los 2.3 GB de esta imagen, y la web tiene la suya.
FROM node:22-slim AS base
WORKDIR /app
# Prisma (migrate) y engines nativos necesitan OpenSSL en imágenes slim. También al generar el cliente: sin
# OpenSSL detecta «native» como openssl-1.1 y baja un segundo motor (16 MB) que aquí nunca se usa.
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM base AS manifiestos
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json

FROM manifiestos AS deps
RUN --mount=type=cache,target=/root/.npm npm ci --workspace=apps/api --include-workspace-root --prefer-offline --no-audit --no-fund
COPY apps/api/prisma/schema.prisma apps/api/prisma/schema.prisma
RUN npm run prisma:generate --workspace=apps/api

FROM deps AS build
ENV NODE_OPTIONS=--max-old-space-size=3072
COPY apps/api apps/api
COPY scripts/clear-build-cache.js scripts/clear-build-cache.js
RUN npm run build --workspace=apps/api

FROM deps AS prod-deps
# `prisma`, `ts-node`, `@types/bcryptjs` y `sharp` son de producción a propósito: migraciones y sembradores corren
# dentro de la imagen (`prisma db seed` revisa tipos), y los croquis y las fotos de vehículos usan sharp.
RUN npm prune --omit=dev --workspace=apps/api --include-workspace-root --no-audit --no-fund

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3001
# Default runtime heap; compose may override via NODE_OPTIONS.
ENV NODE_OPTIONS=--max-old-space-size=2048
ENV HEALTH_HEAP_LIMIT_MB=1536

# poppler-utils: `pdftotext` lee el manual de un vehículo sin cargarlo entero en memoria.
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends poppler-utils \
  && rm -rf /var/lib/apt/lists/*

# Raíz: dependencias hoisted del monorepo
COPY --from=prod-deps /app/node_modules ./node_modules
# apps/api: aquí npm deja deps solo del workspace (p. ej. @nestjs/terminus); sin esto el API crashea al arrancar
COPY --from=prod-deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/src/assets ./apps/api/dist/assets
COPY --from=build /app/apps/api/prisma ./apps/api/prisma

# Fallar el build si Terminus no está (evita imagen “verde” que crashea al arrancar)
RUN test -d node_modules/@nestjs/terminus || test -d apps/api/node_modules/@nestjs/terminus
# Y si dist/ usa un paquete que no quedó en la imagen: sharp, por ejemplo, no truena al arrancar sino al usarse.
RUN --mount=type=bind,from=build,source=/app/apps/api/scripts/comprobar-dependencias-dist.cjs,target=/tmp/comprobar-dependencias-dist.cjs \
  node /tmp/comprobar-dependencias-dist.cjs

RUN mkdir -p /app/uploads

EXPOSE 3001
# Migrations run via deploy/update.sh --with-migrate (or nexara.sh), not at every
# container start — otherwise every restart serves 502 until prisma finishes.
CMD ["node", "/app/apps/api/dist/main.js"]
