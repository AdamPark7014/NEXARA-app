FROM node:22-slim AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/mobile/package.json apps/mobile/package.json

RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline --no-audit

FROM deps AS build
WORKDIR /app
COPY . .
RUN npm run prisma:generate --workspace=apps/api
RUN npm run build --workspace=apps/api

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001

# Prisma (migrate) y engines nativos necesitan OpenSSL en imágenes slim
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Raíz: dependencias hoisted del monorepo
COPY --from=build /app/node_modules ./node_modules
# apps/api: aquí npm deja deps solo del workspace (p. ej. @nestjs/terminus); sin esto el API crashea al arrancar
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma

# Fallar el build si Terminus no está (evita imagen “verde” que crashea al arrancar)
RUN test -d node_modules/@nestjs/terminus || test -d apps/api/node_modules/@nestjs/terminus

RUN mkdir -p /app/uploads

EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
