FROM node:22-slim AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json

# Solo lo de la web: las dependencias de la API y de la raíz no se usan aquí.
RUN --mount=type=cache,target=/root/.npm npm ci --workspace=apps/web --prefer-offline --no-audit --no-fund

FROM deps AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV CLEAR_SKIP_NEXT_CACHE=true
ENV NEXT_OUTPUT_STANDALONE=1
ENV NODE_OPTIONS=--max-old-space-size=3072
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_API_ASSET_ORIGIN
ARG NEXT_PUBLIC_ALLOW_CROSS_ORIGIN_API
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ARG NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID
ARG NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY
ARG NEXT_PUBLIC_WEB_PUSH_CONSENT_MODE
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ARG NEXT_PUBLIC_BING_SITE_VERIFICATION
ARG NEXT_PUBLIC_CONTACT_PHONE
ARG NEXT_PUBLIC_CONTACT_EMAIL
ARG NEXT_PUBLIC_CITY
ARG NEXT_PUBLIC_STATE
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SOCKET_URL=${NEXT_PUBLIC_SOCKET_URL}
ENV NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL}
ENV NEXT_PUBLIC_API_ASSET_ORIGIN=${NEXT_PUBLIC_API_ASSET_ORIGIN}
ENV NEXT_PUBLIC_ALLOW_CROSS_ORIGIN_API=${NEXT_PUBLIC_ALLOW_CROSS_ORIGIN_API}
ENV NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=${NEXT_PUBLIC_GOOGLE_MAPS_API_KEY}
ENV NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=${NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID}
ENV NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=${NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY}
ENV NEXT_PUBLIC_WEB_PUSH_CONSENT_MODE=${NEXT_PUBLIC_WEB_PUSH_CONSENT_MODE}
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=${NEXT_PUBLIC_GA_MEASUREMENT_ID}
ENV NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=${NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION}
ENV NEXT_PUBLIC_BING_SITE_VERIFICATION=${NEXT_PUBLIC_BING_SITE_VERIFICATION}
ENV NEXT_PUBLIC_CONTACT_PHONE=${NEXT_PUBLIC_CONTACT_PHONE}
ENV NEXT_PUBLIC_CONTACT_EMAIL=${NEXT_PUBLIC_CONTACT_EMAIL}
ENV NEXT_PUBLIC_CITY=${NEXT_PUBLIC_CITY}
ENV NEXT_PUBLIC_STATE=${NEXT_PUBLIC_STATE}
# CACHEBUST invalida la capa COPY cuando el rebuild debe forzar fuentes nuevas
ARG CACHEBUST=1
RUN echo "web-cachebust=${CACHEBUST}"
COPY apps/web apps/web
COPY shared shared
COPY tsconfig.base* ./
COPY scripts/clear-build-cache.js scripts/next-build-resilient.js scripts/
RUN --mount=type=cache,target=/app/apps/web/.next/cache npm run build --workspace=apps/web

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
# Docker pone aquí el id del contenedor; sin esto, server.js no escucharía en todas las interfaces.
ENV HOSTNAME=0.0.0.0

# `standalone` trae solo lo que el servidor usa de node_modules; lo estático se copia aparte, como pide Next.
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
